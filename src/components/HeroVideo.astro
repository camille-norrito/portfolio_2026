---
// src/components/HeroVideo.astro
---

<section id="hero-wrapper" style="position:relative;height:100vh;">
    <!-- HERO STICKY qui rétrécit au scroll -->
    <div
        id="hero-video"
        style="position:sticky;top:0;width:100%;height:100vh;overflow:hidden;background:#0a0808;transition:height 0.05s linear;"
    >
        <!-- VIDÉO BACKGROUND -->
        <video
            id="hero-vid"
            autoplay
            muted
            loop
            playsinline
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 1.2s ease;"
        >
            <source src="/hero.mp4" type="video/mp4" />
            <source src="/hero.webm" type="video/webm" />
        </video>

        <!-- FALLBACK IMAGE -->
        <img
            id="hero-fallback"
            src="/image-hero.JPG"
            alt="Hero"
            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:1;transition:opacity 1.2s ease;"
        />

        <!-- OVERLAY GRADIENT -->
        <div
            style="position:absolute;inset:0;background:linear-gradient(to bottom, rgba(10,8,8,0.3) 0%, rgba(10,8,8,0.1) 40%, rgba(10,8,8,0.65) 100%);z-index:1;"
        >
        </div>

        <!-- GRAIN OVERLAY -->
        <div
            style="position:absolute;inset:0;z-index:2;opacity:0.08;pointer-events:none;background-image:url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noise%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noise)%22/%3E%3C/svg%3E');background-size:200px;"
        >
        </div>

        <!-- LIGNES DÉCORATIVES -->
        <div
            id="hero-line-left"
            style="position:absolute;left:3rem;top:0;width:1px;background:rgba(255,255,255,0.2);height:0;z-index:3;transition:height 1.2s 0.8s cubic-bezier(0.16,1,0.3,1);"
        >
        </div>
        <div
            id="hero-line-right"
            style="position:absolute;right:3rem;top:0;width:1px;background:rgba(255,255,255,0.2);height:0;z-index:3;transition:height 1.2s 0.9s cubic-bezier(0.16,1,0.3,1);"
        >
        </div>

        <!-- CONTENU — visible uniquement en plein écran -->
        <div
            id="hero-content"
            style="position:absolute;inset:0;z-index:4;display:flex;flex-direction:column;justify-content:flex-end;padding:0 3rem 8rem;transition:opacity 0.3s ease;"
        >
            <!-- TAG ROUGE -->
            <div
                id="hero-tag"
                style="position:absolute;top:6rem;left:3rem;opacity:0;transform:translateX(-20px);transition:opacity 0.6s 1.4s ease, transform 0.6s 1.4s ease;"
            >
                <p
                    style="font-family:'Montserrat';font-size:10px;font-weight:700;letter-spacing:0.3em;color:#B50D0B;text-transform:uppercase;"
                >
                    ✦ PORTFOLIO — 2026
                </p>
            </div>

            <!-- SCROLL INDICATOR -->
            <div
                id="hero-scroll-hint"
                style="position:absolute;top:6rem;right:3rem;opacity:0;transition:opacity 0.6s 1.8s ease;display:flex;flex-direction:column;align-items:center;gap:8px;"
            >
                <p
                    style="font-family:'Montserrat';font-size:9px;letter-spacing:0.25em;color:rgba(255,255,255,0.5);text-transform:uppercase;writing-mode:vertical-rl;"
                >
                    SCROLL
                </p>
                <div
                    id="scroll-line"
                    style="width:1px;height:0;background:rgba(255,255,255,0.4);transition:height 1s 2.2s ease;"
                >
                </div>
            </div>

            <!-- TITRE -->
            <div style="overflow:hidden;margin-bottom:1.5rem;">
                <h1
                    id="hero-title"
                    style="font-family:'Horizon';font-size:clamp(48px,9vw,130px);color:white;text-transform:uppercase;letter-spacing:-0.02em;line-height:0.9;opacity:0;transform:translateY(60px);transition:opacity 0.9s 0.6s ease, transform 0.9s 0.6s cubic-bezier(0.16,1,0.3,1);"
                >
                    PROJETS
                </h1>
            </div>

            <!-- SÉPARATEUR + SOUS-TITRE -->
            <div
                style="display:flex;align-items:center;gap:2rem;margin-bottom:2rem;"
            >
                <div
                    id="hero-sep"
                    style="height:1px;background:rgba(255,255,255,0.3);width:0;transition:width 0.8s 1.2s ease;"
                >
                </div>
                <p
                    id="hero-subtitle"
                    style="font-family:'Montserrat';font-size:11px;letter-spacing:0.2em;color:rgba(255,255,255,0.6);text-transform:uppercase;white-space:nowrap;opacity:0;transition:opacity 0.6s 1.5s ease;"
                >
                    Design · Branding · Motion · Photo
                </p>
            </div>

            <!-- BOUTON SCROLL DOWN -->
            <div
                id="hero-cta"
                style="opacity:0;transform:translateY(20px);transition:opacity 0.6s 1.8s ease, transform 0.6s 1.8s ease;margin-bottom:1.5rem;"
            >
                <button
                    id="hero-scroll-btn"
                    onclick="document.getElementById('projets-grid').scrollIntoView({behavior:'smooth'})"
                    style="width:56px;height:56px;border-radius:50%;border:1.5px solid rgba(255,255,255,0.4);background:transparent;color:white;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background 0.3s, border-color 0.3s;margin-left:2rem;"
                >
                    <svg
                        width="18"
                        height="18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                    >
                        <path d="M12 5v14M5 12l7 7 7-7"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- BARRE PROGRESSION -->
        <div
            style="position:absolute;bottom:0;left:0;width:100%;height:2px;background:rgba(255,255,255,0.08);z-index:5;"
        >
            <div
                id="hero-vidbar"
                style="height:100%;width:0%;background:#B50D0B;transition:width 0.1s linear;"
            >
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        var wrapper = document.getElementById("hero-wrapper");
        var hero = document.getElementById("hero-video");
        var content = document.getElementById("hero-content");
        var vid = document.getElementById(
            "hero-vid",
        ) as HTMLVideoElement | null;
        var vidbar = document.getElementById("hero-vidbar");
        var fallback = document.getElementById("hero-fallback");

        var MIN_H = 40; // hauteur du bandeau en vh
        var MAX_H = 100; // hauteur initiale en vh
        var SHRINK_OVER = 200; // pixels pour déclencher le rétrécissement
        var hasShrunken = false;

        // Le wrapper prend juste la hauteur du hero initial
        if (wrapper) wrapper.style.height = MAX_H + "vh";

        function onScroll() {
            if (!hero || !content) return;
            var scrollY = window.scrollY;

            if (!hasShrunken && scrollY > 30) {
                // On a scrollé : rétrécir et ne plus revenir en grand
                hasShrunken = true;
                hero.style.transition =
                    "height 0.5s cubic-bezier(0.16,1,0.3,1)";
                hero.style.height = MIN_H + "vh";
                content.style.transition = "opacity 0.3s ease";
                content.style.opacity = "0";
                // Réduire aussi le wrapper pour coller les projets
                if (wrapper) {
                    wrapper.style.transition =
                        "height 0.5s cubic-bezier(0.16,1,0.3,1)";
                    wrapper.style.height = MIN_H + "vh";
                }
            }
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        // Vidéo
        if (vid) {
            var v = vid;
            var videoLoaded = false;

            setTimeout(function () {
                if (!videoLoaded && fallback) {
                    v.style.opacity = "0";
                    if (fallback) fallback.style.opacity = "1";
                } else if (videoLoaded) {
                    v.style.opacity = "1";
                    if (fallback) fallback.style.opacity = "0";
                }
            }, 800);

            var seekDone = false;
            function trySeek() {
                if (seekDone) return;
                v.currentTime = 20;
                seekDone = true;
                videoLoaded = true;
                v.style.opacity = "1";
                if (fallback) fallback.style.opacity = "0";
            }

            v.addEventListener("loadedmetadata", trySeek);
            v.addEventListener("canplay", trySeek);
            v.addEventListener("playing", function () {
                videoLoaded = true;
                v.style.opacity = "1";
                if (fallback) fallback.style.opacity = "0";
            });
            if (v.readyState >= 1) trySeek();

            v.addEventListener("timeupdate", function () {
                if (vidbar && v.duration) {
                    vidbar.style.width =
                        (v.currentTime / v.duration) * 100 + "%";
                }
            });
        }

        // Animations au chargement
        var title = document.getElementById("hero-title");
        var tag = document.getElementById("hero-tag");
        var sep = document.getElementById("hero-sep");
        var subtitle = document.getElementById("hero-subtitle");
        var cta = document.getElementById("hero-cta");
        var lineL = document.getElementById("hero-line-left");
        var lineR = document.getElementById("hero-line-right");
        var scrollHint = document.getElementById("hero-scroll-hint");
        var scrollLine = document.getElementById("scroll-line");

        function reveal() {
            if (lineL) lineL.style.height = "100%";
            if (lineR) lineR.style.height = "100%";
            if (title) {
                title.style.opacity = "1";
                title.style.transform = "translateY(0)";
            }
            if (tag) {
                tag.style.opacity = "1";
                tag.style.transform = "translateX(0)";
            }
            if (sep) sep.style.width = "80px";
            if (subtitle) subtitle.style.opacity = "1";
            if (cta) {
                cta.style.opacity = "1";
                cta.style.transform = "translateY(0)";
            }
            if (scrollHint) scrollHint.style.opacity = "1";
            if (scrollLine) scrollLine.style.height = "60px";
        }
        setTimeout(reveal, 200);

        // Hover bouton
        var btn = document.getElementById(
            "hero-scroll-btn",
        ) as HTMLElement | null;
        if (btn) {
            var b = btn;
            b.addEventListener("mouseenter", function () {
                b.style.background = "white";
                b.style.color = "black";
                b.style.borderColor = "white";
            });
            b.addEventListener("mouseleave", function () {
                b.style.background = "transparent";
                b.style.color = "white";
                b.style.borderColor = "rgba(255,255,255,0.4)";
            });
        }
    })();
</script>

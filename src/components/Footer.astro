---
import Icon_behance from "../assets/icons/Icon_behance.svg";
import Icon_insta from "../assets/icons/Icon_insta.svg";
import Icon_linkedin from "../assets/icons/Icon_linkedin.svg";
---

<style>
    :global(body) {
        overflow-x: hidden;
    }

    :global(main) {
        position: relative;
        z-index: 1;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    }

    :global(.footer-sticky-wrapper) {
        position: sticky;
        bottom: 0;
        z-index: 0;
    }

    .ft-contact-m {
        display: none;
    }

    /* Mobile : tout le contenu, en plus petit et rangé sur deux colonnes */
    @media (max-width: 767px) {
        footer .grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 2rem 1rem;
        }
        .ft-col-social {
            grid-column: 1 / -1;
            order: -1;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;
            column-gap: 0.4em;
        }
        .ft-col-social > div {
            flex-basis: 100%;
            margin-top: 0.9rem;
        }
        .ft-col-social .ft-follow,
        .ft-col-social .ft-follow-me {
            display: inline;
            font-size: 11px !important;
            line-height: 1 !important;
            letter-spacing: 0.2em;
            font-weight: 700;
        }
        .ft-col-social .ft-follow,
        .ft-col-social .ft-follow-me {
            margin: 0 !important;
        }
        .ft-col-social img {
            width: 1.6rem;
            height: 1.6rem;
        }
        .ft-col-projets {
            text-align: left;
        }
        .ft-col-res {
            text-align: right;
        }
        .ft-col-projets .footer-title,
        .ft-col-res .footer-title {
            font-size: 11px !important;
            line-height: 1.2 !important;
            letter-spacing: 0.2em;
            margin-bottom: 0.9rem !important;
        }
        .ft-col-projets .text-content,
        .ft-col-res .text-content {
            font-size: 13px !important;
            line-height: 1.35 !important;
        }
        .ft-col-projets ul,
        .ft-col-res ul {
            display: flex;
            flex-direction: column;
            gap: 0.55rem;
        }
        .ft-col-projets ul > * + *,
        .ft-col-res ul > * + * {
            margin-top: 0 !important;
        }
        .ft-desktop-only {
            display: none;
        }
        .ft-contact-m {
            grid-column: 1 / -1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.35rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            font-family: "Montserrat";
            font-size: 15px;
            font-weight: 700;
        }
    }

    .footer-signature {
        overflow: hidden;
        pointer-events: none;
    }
    .footer-portfolio {
        font-family: "Montserrat";
        font-size: clamp(14px, 2.2vw, 30px);
        line-height: 1;
        color: #fff;
        text-align: right;
        padding: 0 1.5rem;
        margin: 0 0 0.25em;
    }
    .footer-name {
        display: block;
        width: max-content;
        margin: 0;
        font-family: "Horizon";
        font-weight: 700;
        font-size: 7.3vw;
        line-height: 0.82;
        letter-spacing: -0.02em;
        white-space: nowrap;
        color: #fff;
        transform: translateY(10%);
    }
</style>

<div class="footer-sticky-wrapper">
    <div class="w-full border-t border-black"></div>

    <footer class="relative w-full bg-black overflow-hidden">
        <div class="max-w-7xl mx-auto py-10 md:py-16 px-6 md:px-16">
            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-12 mb-10 md:mb-16"
            >
                <!-- COLONNE 1 : MES PROJETS -->
                <div class="ft-col-projets text-center md:text-left">
                    <a
                        href="/projets"
                        class="footer-title mb-4 md:mb-6 text-white hover:text-red transition-colors block"
                    >
                        MES PROJETS
                    </a>
                    <ul class="space-y-2 md:space-y-3">
                        <li>
                            <a
                                href="/projets#cat-affiche"
                                class="text-content text-white hover:text-red transition-colors block"
                            >
                                Affiche
                            </a>
                        </li>
                        <li>
                            <a
                                href="/projets#cat-identite"
                                class="text-content text-white hover:text-red transition-colors block"
                            >
                                Identité visuelle
                            </a>
                        </li>
                        <li>
                            <a
                                href="/projets#cat-uxui-jeu"
                                class="text-content text-white hover:text-red transition-colors block"
                            >
                                UX/UI & Jeu vidéo
                            </a>
                        </li>
                        <li>
                            <a
                                href="/projets#cat-audiovisuel"
                                class="text-content text-white hover:text-red transition-colors block"
                            >
                                Audiovisuel
                            </a>
                        </li>
                        <!-- Téléphone -->
                        <li class="ft-desktop-only pt-[15px]">
                            <a
                                href="tel:+33768639449"
                                class="footer-title text-white hover:text-red transition-colors block"
                            >
                                +(33) 7 68 63 94 49
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- COLONNE 2 : FOLLOW ME ON -->
                <div class="ft-col-social flex flex-col items-center">
                    <p class="ft-follow footer-title mb-1 md:mb-2 text-white text-center">
                        FOLLOW
                    </p>
                    <p class="ft-follow-me text-content text-white mb-4 md:mb-6 text-center">
                        ME ON
                    </p>
                    <div
                        class="flex gap-5 md:gap-6 items-center justify-center"
                    >
                        <a
                            href="https://www.instagram.com/camille.norrito"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:opacity-70 transition-opacity"
                            aria-label="Instagram"
                        >
                            <img
                                src={Icon_insta.src}
                                alt="Instagram"
                                class="w-8 h-8 md:w-8 md:h-8 invert"
                            />
                        </a>
                        <a
                            href="https://behance.net/votre_compte"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:opacity-70 transition-opacity"
                            aria-label="Behance"
                        >
                            <img
                                src={Icon_behance.src}
                                alt="Behance"
                                class="w-8 h-8 md:w-8 md:h-8 invert"
                            />
                        </a>
                        <a
                            href="https://www.linkedin.com/in/camille-norrito-9b25a0334"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:opacity-70 transition-opacity"
                            aria-label="LinkedIn"
                        >
                            <img
                                src={Icon_linkedin.src}
                                alt="LinkedIn"
                                class="w-8 h-8 md:w-8 md:h-8 invert"
                            />
                        </a>
                    </div>
                </div>

                <!-- COLONNE 3 : RESSOURCES -->
                <div class="ft-col-res text-center md:text-right">
                    <p class="footer-title mb-4 md:mb-6 text-white">
                        RESSOURCES
                    </p>
                    <ul class="space-y-2 md:space-y-3">
                        <li>
                            <a
                                href="/mentions-legales#politique-confidentialite"
                                class="text-content text-white hover:text-red transition-colors block"
                            >
                                Politique de Confidentialité
                            </a>
                        </li>
                        <li>
                            <a
                                href="/#a-propos"
                                class="text-content text-white hover:text-red transition-colors block"
                            >
                                À propos
                            </a>
                        </li>
                        <li>
                            <a
                                href="/contact"
                                class="text-content text-white hover:text-red transition-colors block"
                            >
                                Contact
                            </a>
                        </li>
                        <li>
                            <a
                                href="/mentions-legales"
                                class="text-content text-white hover:text-red transition-colors block"
                            >
                                Mentions Légales
                            </a>
                        </li>
                        <!-- Email -->
                        <li class="ft-desktop-only pt-[15px]">
                            <a
                                href="mailto:camillenorrito.pro@gmail.com"
                                class="footer-title text-white hover:text-red transition-colors block"
                            >
                                camillenorrito.pro@gmail.com
                            </a>
                        </li>
                    </ul>
                </div>
                <!-- Mobile : téléphone et e-mail regroupés sous les colonnes -->
                <div class="ft-contact-m">
                    <a href="tel:+33768639449" class="text-white hover:text-red transition-colors">+(33) 7 68 63 94 49</a>
                    <a href="mailto:camillenorrito.pro@gmail.com" class="text-white hover:text-red transition-colors">camillenorrito.pro@gmail.com</a>
                </div>
            </div>
        </div>

        <!-- TEXTE GÉANT EN BAS -->
        <div id="footer-signature" class="footer-signature">
            <p class="footer-portfolio">PORTFOLIO.</p>
            <h1 id="footer-name" class="footer-name">CAMILLE NORRITO</h1>
        </div>
    </footer>
</div>

<script>
    // CAMILLE NORRITO sur toute la largeur du footer
    (function () {
        var box = document.getElementById("footer-signature");
        var name = document.getElementById("footer-name");
        if (!box || !name) return;
        var b = box, n = name;
        function fit() {
            n.style.fontSize = "100px";
            var w = n.getBoundingClientRect().width;
            if (w > 0) n.style.fontSize = (100 * b.clientWidth) / w + "px";
        }
        fit();
        window.addEventListener("resize", fit);
        if (document.fonts) document.fonts.ready.then(fit);
    })();

</script>

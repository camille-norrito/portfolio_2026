---
// src/components/ProjectsIntro.astro
---

<div style="position:sticky;top:0;z-index:5;background:#fff;">
    <!-- Ligne 1 : grand titre + flèche -->
    <section
        style="padding:5rem 4rem 0;display:flex;align-items:flex-start;justify-content:space-between;gap:4rem;border-top:2px solid #261F1C;"
    >
        <h2
            style="font-family:'Montserrat';font-size:clamp(52px,9vw,130px);font-weight:900;color:#261F1C;text-transform:uppercase;letter-spacing:-0.03em;line-height:0.88;margin:0;"
        >
            MES<br />PROJETS
        </h2>
        <svg
            style="flex-shrink:0;margin-top:0.5rem;"
            width="70"
            height="70"
            viewBox="0 0 80 80"
            fill="none"
        >
            <path
                d="M10 70 L70 10 M70 10 H20 M70 10 V60"
                stroke="#261F1C"
                stroke-width="5"
                stroke-linecap="square"></path>
        </svg>
    </section>

    <!-- Ligne 2 : astérisque + disciplines + description -->
    <section
        style="padding:1.5rem 4rem 3rem;display:flex;align-items:flex-start;gap:3rem;border-bottom:1px solid rgba(38,31,28,0.12);"
    >
        <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            style="flex-shrink:0;margin-top:0.2rem;"
        >
            <path
                d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07"
                stroke="#261F1C"
                stroke-width="2"
                stroke-linecap="round"></path>
        </svg>
        <div
            style="display:flex;align-items:flex-start;justify-content:space-between;flex:1;gap:3rem;"
        >
            <p
                style="font-family:'Montserrat';font-size:11px;font-weight:700;letter-spacing:0.12em;color:#261F1C;text-transform:uppercase;line-height:1.6;max-width:340px;margin:0;"
            >
                Design graphique · Branding<br />Motion design · UX/UI ·
                Audiovisuel
            </p>
            <p
                style="font-family:'Montserrat';font-size:11px;line-height:1.8;color:rgba(38,31,28,0.5);max-width:320px;margin:0;text-align:right;"
            >
                Une sélection de projets réalisés dans le cadre de mes études
                MMI — du concept à la direction artistique finale.
            </p>
        </div>
    </section>
</div>

---
// Hero.astro - Démarre après LoadingAnimation
---

<section class="relative w-full h-screen overflow-hidden">
    <!-- Image plein écran -->
    <div class="absolute inset-0">
        <img
            src="/image-hero.JPG"
            alt="Portfolio Camille Norrito"
            class="w-full h-full object-cover"
        />
    </div>

    <!-- Texte "CAMILLE WEBSITE" en bas à gauche -->
    <div class="absolute bottom-8 left-8 md:bottom-16 md:left-16">
        <!-- Chaque ligne apparaît progressivement -->
        <div class="overflow-hidden">
            <h2
                id="hero-line-1"
                class="font-horizon text-white leading-none opacity-0"
                style="font-size: clamp(3rem, 8vw, 10rem); letter-spacing: -0.02em; transform: translateY(100%);"
            >
                CAMILLE'S
            </h2>
        </div>
        <div class="overflow-hidden">
            <h1
                id="hero-line-2"
                class="font-horizon text-white leading-none opacity-0"
                style="font-size: clamp(3rem, 8vw, 10rem); letter-spacing: -0.02em; transform: translateY(100%);"
            >
                WEBSITE
            </h1>
        </div>
    </div>
</section>

<style>
    /* Animation de révélation progressive - slide up */
    @keyframes slideUpReveal {
        0% {
            opacity: 0;
            transform: translateY(100%);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    #hero-line-1.animate {
        animation: slideUpReveal 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    #hero-line-2.animate {
        animation: slideUpReveal 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.2s forwards;
    }
</style>

<script>
    let animationStarted = false;

    function startHeroAnimation() {
        // Éviter de lancer plusieurs fois
        if (animationStarted) return;
        animationStarted = true;

        const line1 = document.getElementById("hero-line-1");
        const line2 = document.getElementById("hero-line-2");

        if (line1 && line2) {
            // Démarrer immédiatement (le loading vient de finir)
            line1.classList.add("animate");
            line2.classList.add("animate");
        }
    }

    // ATTENDRE la fin du LoadingAnimation
    window.addEventListener("loadingComplete", () => {
        startHeroAnimation();
    });

    // Fallback : Si pas de LoadingAnimation, démarrer après DOMContentLoaded
    document.addEventListener("DOMContentLoaded", () => {
        // Vérifier si le loading screen existe
        const loadingScreen = document.getElementById("loading-screen");

        // Si pas de loading screen, démarrer l'animation après 500ms
        if (!loadingScreen) {
            setTimeout(startHeroAnimation, 500);
        }
    });
</script>

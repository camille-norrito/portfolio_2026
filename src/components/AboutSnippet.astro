---
// src/components/AboutSnippet.astro
// Infos à garder à jour avec public/cv.pdf
---

<section id="a-propos" class="about">
    <div class="about-lines">
        <p class="about-line">Étudiante 3e année</p>
        <p class="about-line">Art direction</p>
        <p class="about-line">&amp; stratégie de communication</p>

        <p class="about-line about-stage">Recherche un stage de 16 semaines</p>
        <p class="about-line about-stage">à partir du 15 février 2027</p>
    </div>

    <div class="about-ctas">
        <a href="/cv.pdf" download="CV_Camille_Norrito_Stage_2027.pdf" class="about-btn about-btn-primary">
            Télécharger mon CV
        </a>
        <a href="/contact" class="about-btn about-btn-secondary">Me contacter</a>
    </div>
</section>

<style>
    .about {
        --green: #c3ef5c;
        --ink: #1e1b1f;
        position: relative;
        z-index: 5;
        background: var(--green);
        color: var(--ink);
        padding: 6rem 1.5rem 5rem;
        overflow: hidden;
        text-align: center;
    }


    .about-lines {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .about-line {
        margin: 0;
        font-family: "Anton", "Impact", sans-serif;
        font-size: clamp(34px, 6vw, 96px);
        line-height: 1;
        text-transform: uppercase;
        text-wrap: balance;
        will-change: transform;
    }
    /* L'info la plus importante : bandeau gris foncé, lettres vertes */
    .about-stage {
        background: var(--ink);
        color: var(--green);
        padding: 0.05em 0.3em 0.1em;
    }
    .about-stage:first-of-type {
        margin-top: 0.35em;
    }

    .about-ctas {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
        margin-top: 3rem;
    }
    .about-btn {
        font-family: "Montserrat", sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        padding: 13px 26px;
        border-radius: 30px;
        text-decoration: none;
        transition: background 0.3s, color 0.3s, border-color 0.3s;
    }
    .about-btn-primary {
        background: var(--ink);
        color: var(--green);
        border: 1.5px solid var(--ink);
    }
    .about-btn-primary:hover {
        background: transparent;
        color: var(--ink);
    }
    .about-btn-secondary {
        color: var(--ink);
        border: 1.5px solid var(--ink);
    }
    .about-btn-secondary:hover {
        background: var(--ink);
        color: var(--green);
    }

    @media (max-width: 767px) {
        .about {
            padding: 4rem 1rem 3.5rem;
        }
    }
</style>

<script>
    // Au scroll, les lignes glissent légèrement, une vers la gauche, une vers la droite
    (function () {
        var section = document.getElementById("a-propos");
        if (!section || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var s = section;
        var lines = Array.prototype.slice.call(s.querySelectorAll(".about-line")) as HTMLElement[];
        var ticking = false;
        function update() {
            ticking = false;
            var r = s.getBoundingClientRect();
            var vh = window.innerHeight;
            if (r.bottom < 0 || r.top > vh) return;
            var p = (vh - r.top) / (vh + r.height); // 0 → 1 pendant la traversée
            lines.forEach(function (el, i) {
                var dir = i % 2 === 0 ? -1 : 1;
                el.style.transform = "translateX(" + (0.5 - p) * dir * 80 + "px)";
            });
        }
        window.addEventListener("scroll", function () {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
    })();
</script>

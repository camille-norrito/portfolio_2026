---
// src/components/StackedProjects.astro
const PB_URL = "http://127.0.0.1:8090";

let projets = [];
try {
    const res = await fetch(
        `${PB_URL}/api/collections/projects/records?filter=(has_detail_page=true)&sort=order&perPage=10`
    );
    const data = await res.json();
    projets = data.items.map((p: any) => ({
        title: p.title,
        subtitle: p.subtitle || null,
        category: Array.isArray(p.category) ? p.category[0] : (p.category || null),
        description: p.description || null,
        slug: p.slug,
        coverUrl: p.cover
            ? `${PB_URL}/api/files/${p.collectionId}/${p.id}/${p.cover}`
            : null,
    }));
} catch (e) {
    console.error("Erreur fetch projets stackés:", e);
}

// Palettes — fond clair/foncé alternés, toujours épurées
const palettes = [
    { bg: "#F5F0EA", text: "#261F1C", accent: "#B50D0B", border: "rgba(38,31,28,0.12)", imgBg: "#e8e2db" },
    { bg: "#0E0C0B", text: "#F5F0EA", accent: "#B50D0B", border: "rgba(245,240,234,0.1)", imgBg: "#1a1614" },
    { bg: "#fff",    text: "#261F1C", accent: "#B50D0B", border: "rgba(38,31,28,0.12)", imgBg: "#f0ece8" },
    { bg: "#261F1C", text: "#F5F0EA", accent: "#B50D0B", border: "rgba(245,240,234,0.1)", imgBg: "#1a1614" },
];
---

<div id="stacked-wrapper">
    {projets.map((p: any, i: number) => {
        const pal  = palettes[i % palettes.length];
        const num  = String(i + 1).padStart(2, '0');
        const total = String(projets.length).padStart(2, '0');
        return (
            <div
                class="stacked-section"
                style={`
                    position: sticky;
                    top: 0;
                    height: 90vh;
                    background: ${pal.bg};
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    overflow: hidden;
                    z-index: ${10 + i};
                    border-top: 1px solid ${pal.border};
                `}
            >
                <!-- GAUCHE : infos -->
                <div style={`display:flex;flex-direction:column;justify-content:space-between;padding:3rem 3.5rem;border-right:1px solid ${pal.border};`}>

                    <!-- HAUT : numéro + catégorie -->
                    <div style="display:flex;align-items:center;justify-content:space-between;">
                        <span style={`font-family:'Montserrat';font-size:9px;font-weight:700;letter-spacing:0.25em;color:${pal.accent};text-transform:uppercase;`}>
                            {p.category || "Projet"}
                        </span>
                        <span style={`font-family:'Montserrat';font-size:9px;letter-spacing:0.2em;color:${pal.text};opacity:0.25;`}>
                            {num} / {total}
                        </span>
                    </div>

                    <!-- MILIEU : titre + sous-titre + description -->
                    <div>
                        <h2 style={`font-family:'Montserrat';font-size:clamp(32px,4.5vw,64px);font-weight:900;color:${pal.text};text-transform:uppercase;letter-spacing:-0.03em;line-height:0.88;margin-bottom:1.5rem;`}>
                            {p.title}
                        </h2>
                        {p.subtitle && (
                            <p style={`font-family:'Montserrat';font-size:11px;font-weight:500;letter-spacing:0.1em;color:${pal.text};opacity:0.45;text-transform:uppercase;margin-bottom:1.5rem;`}>
                                {p.subtitle}
                            </p>
                        )}
                        {p.description && (
                            <p style={`font-family:'Montserrat';font-size:12px;line-height:1.85;color:${pal.text};opacity:0.5;max-width:380px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;`}>
                                {p.description}
                            </p>
                        )}
                    </div>

                    <!-- BAS : bouton + ligne -->
                    <div style="display:flex;align-items:center;justify-content:space-between;">
                        <a
                            href={"/projets/" + p.slug}
                            class="stacked-btn"
                            style={`
                                display:inline-flex;align-items:center;gap:0.6rem;
                                font-family:'Montserrat';font-size:9px;font-weight:700;
                                letter-spacing:0.2em;text-transform:uppercase;
                                color:${pal.bg};background:${pal.text};
                                padding:11px 22px;border-radius:30px;
                                text-decoration:none;transition:opacity 0.2s;
                            `}
                        >
                            Voir le projet
                            <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path d="M5 12h14M13 6l6 6-6 6"></path>
                            </svg>
                        </a>
                        <span style={`font-family:'Montserrat';font-size:9px;letter-spacing:0.15em;color:${pal.text};opacity:0.2;text-transform:uppercase;`}>
                            Portfolio
                        </span>
                    </div>
                </div>

                <!-- DROITE : image pleine hauteur -->
                <div style={`position:relative;overflow:hidden;background:${pal.imgBg};`}>
                    {p.coverUrl && (
                        <img
                            src={p.coverUrl}
                            alt={p.title}
                            style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;"
                            loading="lazy"
                        />
                    )}
                </div>

            </div>
        );
    })}
</div>

<style>
    .stacked-btn:hover { opacity: 0.75 !important; }
</style>
---
// src/components/ProjectsRibbon.astro
import { projets } from "../data/projets";

const GRID_COUNT = 6;
// Chaque cover est découpée en bandes verticales pour se courber avec le ruban
const SLICES = 8;
const cards = projets
    .filter((p) => p.cover)
    .map((p) => ({ title: p.title.trim(), slug: p.slug, cover: p.cover, category: p.category[0] || "" }));
const slices = Array.from({ length: SLICES }, (_, k) => k);
---

<section id="ribbon" class="ribbon" style={`--slices:${SLICES}`}>
    <div class="ribbon-pin">
        <h2 class="ribbon-word ribbon-word-left" id="ribbon-left" aria-hidden="true">Mes</h2>
        <h2 class="ribbon-word ribbon-word-right" id="ribbon-right">Projets</h2>

        <div class="ribbon-stage" id="ribbon-stage">
            {cards.map((c, i) =>
                slices.map((k) => (
                    <div class="ribbon-slice" data-card={i} data-k={k} aria-hidden="true">
                        <img src={c.cover} alt="" loading={i < 4 ? "eager" : "lazy"} />
                    </div>
                )),
            )}
        </div>

        <!-- Grille finale : vraies cartes cliquables, posées exactement sur les bandes réassemblées -->
        {cards.slice(0, GRID_COUNT).map((c, i) => (
            <a href={"/projets/" + c.slug} class="ribbon-card" data-card={i} aria-label={c.title}>
                <img src={c.cover} alt="" loading="lazy" />
                <span class="ribbon-caption">
                    <strong>{c.title}</strong>
                    <span>{c.category}</span>
                </span>
            </a>
        ))}

        <p class="ribbon-note" id="ribbon-note">
            Affiches, identités visuelles, UX/UI, jeu vidéo et audiovisuel : une sélection de mes projets.
        </p>
        <p class="ribbon-count" id="ribbon-count">{String(cards.length).padStart(2, "0")} projets</p>

        <a href="/projets" class="ribbon-cta" id="ribbon-cta">
            Découvrir les projets
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
    </div>
</section>

<style>
    .ribbon {
        position: relative;
        height: 520vh;
        background: #c3ef5c;
    }
    .ribbon-pin {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow: hidden;
        perspective: 1400px;
    }

    .ribbon-word {
        position: absolute;
        top: 50%;
        margin: 0;
        font-family: "Montserrat", sans-serif;
        font-weight: 500;
        font-size: clamp(48px, 9vw, 150px);
        line-height: 1;
        letter-spacing: -0.04em;
        text-transform: uppercase;
        color: #1e1b1f;
        white-space: nowrap;
        pointer-events: none;
        will-change: transform, opacity;
    }
    /* « PROJETS » est plus long que « MES » : on décale le duo pour qu'il soit centré */
    .ribbon-word-left {
        right: calc(50% + 1.3em);
        transform: translateY(-110%);
    }
    .ribbon-word-right {
        left: calc(50% - 1.3em);
        transform: translateY(0%);
    }

    .ribbon-stage {
        position: absolute;
        inset: 0;
        transform-style: preserve-3d;
        transform: rotateX(14deg) rotateZ(-10deg);
    }
    .ribbon-slice {
        position: absolute;
        top: 50%;
        left: 50%;
        overflow: hidden;
        backface-visibility: visible;
        will-change: transform, opacity;
        opacity: 0;
    }
    .ribbon-slice img {
        position: absolute;
        top: 0;
        max-width: none;
        object-fit: cover;
        display: block;
    }

    .ribbon-card {
        position: absolute;
        top: 50%;
        left: 50%;
        display: block;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
    }
    .ribbon-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }
    .ribbon-card:hover img {
        transform: scale(1.04);
    }
    .ribbon-caption {
        position: absolute;
        inset: auto 0 0 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 2rem 0.9rem 0.8rem;
        font-family: "Montserrat", sans-serif;
        color: #fff;
        background: linear-gradient(to top, rgba(10, 8, 8, 0.7), rgba(10, 8, 8, 0));
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .ribbon-caption strong {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .ribbon-caption span {
        font-size: 10px;
        letter-spacing: 0.06em;
        opacity: 0.75;
    }
    .ribbon-card:hover .ribbon-caption,
    .ribbon-card:focus-visible .ribbon-caption {
        opacity: 1;
        transform: translateY(0);
    }
    .ribbon-card:focus-visible {
        outline: 2px solid #c3ef5c;
        outline-offset: 3px;
    }

    .ribbon-note,
    .ribbon-count {
        position: absolute;
        bottom: 1.75rem;
        margin: 0;
        font-family: "Montserrat", sans-serif;
        font-size: 11px;
        line-height: 1.5;
        color: rgba(30, 27, 31, 0.75);
    }
    .ribbon-note {
        left: 2rem;
        max-width: 260px;
    }
    .ribbon-count {
        right: 2rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .ribbon-cta {
        position: absolute;
        left: 50%;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        font-family: "Montserrat", sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #c3ef5c;
        background: #1e1b1f;
        border: 1.5px solid #1e1b1f;
        padding: 13px 26px;
        border-radius: 30px;
        text-decoration: none;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, 12px);
        transition: background 0.3s, color 0.3s;
    }
    .ribbon-cta:hover {
        background: #c3ef5c;
        color: #1e1b1f;
    }

    @media (max-width: 767px) {
        .ribbon-note {
            display: none;
        }
        .ribbon-count {
            right: 1rem;
            bottom: 1rem;
        }
    }
</style>

<script>
    (function () {
        var section = document.getElementById("ribbon");
        var stage = document.getElementById("ribbon-stage");
        if (!section || !stage) return;
        var s = section;
        var left = document.getElementById("ribbon-left");
        var right = document.getElementById("ribbon-right");
        var cta = document.getElementById("ribbon-cta");
        var note = document.getElementById("ribbon-note");
        var count = document.getElementById("ribbon-count");
        var slices = Array.prototype.slice.call(s.querySelectorAll(".ribbon-slice")) as HTMLElement[];
        var cards = Array.prototype.slice.call(s.querySelectorAll(".ribbon-card")) as HTMLElement[];
        var N = parseInt(getComputedStyle(s).getPropertyValue("--slices"), 10) || 8;
        var n = slices.length / N;
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function clamp01(x: number) { return Math.min(1, Math.max(0, x)); }
        function lerp(a: number, b: number, k: number) { return a + (b - a) * k; }
        function step(p: number, from: number, to: number) {
            var k = clamp01((p - from) / (to - from));
            return k * k * (3 - 2 * k);
        }
        function wrapDeg(d: number) { return ((((d + 180) % 360) + 360) % 360) - 180; }

        // Taille des covers et grille finale (3 × 2, ou 2 × 3 sur mobile)
        var W = 0, H = 0, cardW = 0, cardH = 0, sliceW = 0, gap = 0, R = 0;
        var grid: { x: number; y: number }[] = [];
        function layout() {
            W = s.clientWidth;
            H = window.innerHeight;
            var mobile = W < 768;
            var cols = mobile ? 2 : 3;
            var rows = Math.ceil(6 / cols);
            gap = mobile ? 10 : 20;
            var maxW = (W * (mobile ? 0.9 : 0.72) - gap * (cols - 1)) / cols;
            var maxH = (H * (mobile ? 0.62 : 0.6) - gap * (rows - 1)) / rows;
            cardW = Math.min(maxW, maxH / 0.75);
            cardH = cardW * 0.75;
            sliceW = cardW / N;
            // rayon : le ruban fait un peu plus d'un tour avec toutes les covers bord à bord
            R = Math.max((n * cardW) / (2 * Math.PI) * 0.9, W * 0.3);
            var offsetY = -H * 0.05;
            grid = [];
            for (var g = 0; g < 6; g++) {
                var c = g % cols, r = Math.floor(g / cols);
                grid.push({
                    x: (c - (cols - 1) / 2) * (cardW + gap),
                    y: (r - (rows - 1) / 2) * (cardH + gap) + offsetY,
                });
            }
            slices.forEach(function (el) {
                var k = +(el.dataset.k || 0);
                el.style.width = sliceW + 3 + "px"; // léger chevauchement : pas de jour entre les bandes
                el.style.height = cardH + "px";
                el.style.marginLeft = -sliceW / 2 + "px";
                el.style.marginTop = -cardH / 2 + "px";
                var img = el.firstElementChild as HTMLElement;
                img.style.width = cardW + "px";
                img.style.height = cardH + "px";
                img.style.left = -k * sliceW + "px";
            });
            cards.forEach(function (el, i) {
                el.style.width = cardW + "px";
                el.style.height = cardH + "px";
                el.style.marginLeft = -cardW / 2 + grid[i].x + "px";
                el.style.marginTop = -cardH / 2 + grid[i].y + "px";
            });
            if (cta) cta.style.top = H / 2 + offsetY + (rows * cardH + (rows - 1) * gap) / 2 + 28 + "px";
        }

        // Trajectoire du ruban : une spirale qui entre en bas à gauche, s'enroule autour des mots
        // en montant, puis sort par le haut. Tout le ruban suit le même chemin derrière sa tête,
        // il reste donc d'un seul tenant. phi = angle autour de l'axe vertical (radians).
        function pathAt(phi: number) {
            var rise = H * 0.165; // montée par radian
            var wave = H * 0.05;
            var L = Math.sqrt(R * R + rise * rise); // longueur de bande par radian
            var y = H * 0.65 - rise * (phi + Math.PI / 2) + Math.sin(phi * 1.5) * wave;
            var dy = -rise + Math.cos(phi * 1.5) * 1.5 * wave;
            return {
                x: R * Math.sin(phi),
                y: y,
                z: R * Math.cos(phi) - R * 0.75,
                ry: wrapDeg((phi * 180) / Math.PI),
                rz: (Math.atan(dy / L) * 180) / Math.PI,
                L: L,
            };
        }

        var ticking = false;
        function update() {
            ticking = false;
            var total = s.offsetHeight - H;
            var p = reduce ? 1 : total > 0 ? clamp01(-s.getBoundingClientRect().top / total) : 1;
            var mobile = W < 768;

            // 1. Le ruban fait tout son parcours et sort entièrement par le haut (0 → 0.72)
            var P = pathAt(0);
            var rise = H * 0.165;
            var ribbonLen = (n * cardW) / P.L; // longueur du ruban, en radians de trajectoire
            var headStart = -Math.PI / 2 + 0.9;
            var headEnd = -Math.PI / 2 + (H * 2.3) / rise + ribbonLen; // la queue a quitté l'écran
            var head = lerp(headStart, headEnd, clamp01(p / 0.75));

            slices.forEach(function (el) {
                var i = +(el.dataset.card || 0);
                var k = +(el.dataset.k || 0);
                var d = i * cardW + (N - 1 - k + 0.5) * sliceW;
                var rib = pathAt(head - d / P.L);
                el.style.transform =
                    "translate3d(" + rib.x + "px," + rib.y + "px," + rib.z + "px) rotateY(" + rib.ry + "deg) rotateZ(" + rib.rz + "deg)";
                // au-dessus de l'écran, la perspective ramènerait la boucle arrière dans le champ : on l'efface
                el.style.opacity = String(clamp01((rib.y + H * 0.9) / (H * 0.4)));
            });

            // 2. Juste avant que le ruban disparaisse, les 6 projets arrivent un par un,
            //    chacun depuis son coin / son bord de l'écran (0.44 → 0.81)
            var cols = mobile ? 2 : 3;
            var rows = Math.ceil(6 / cols);
            cards.forEach(function (el, i) {
                var c = i % cols, r = Math.floor(i / cols);
                var dirX = cols === 3 ? c - 1 : c === 0 ? -1 : 1;
                var dirY = rows === 2 ? (r === 0 ? -1 : 1) : r - 1;
                var t = step(p, 0.44 + i * 0.045, 0.58 + i * 0.045);
                var x = (1 - t) * dirX * W * 0.55;
                var y = (1 - t) * dirY * H * 0.75;
                var z = (1 - t) * 200;
                el.style.transform =
                    "translate3d(" + x + "px," + y + "px," + z + "px) rotateX(" + (1 - t) * -dirY * 30 + "deg) rotateY(" + (1 - t) * dirX * 35 + "deg)";
                el.style.opacity = String(clamp01(t * 1.6));
                el.style.pointerEvents = t > 0.95 ? "auto" : "none";
            });

            var travel = step(p, 0, 0.62);
            var morphAll = step(p, 0.42, 0.58);

            // Les deux mots s'écartent puis s'effacent
            var spread = travel * W * (W < 768 ? 0.08 : 0.22);
            var wordsOp = String(1 - step(p, 0.42, 0.58));
            if (left) {
                left.style.transform = "translate(" + -spread + "px, -110%)";
                left.style.opacity = wordsOp;
            }
            if (right) {
                right.style.transform = "translate(" + spread + "px, 0%)";
                right.style.opacity = wordsOp;
            }

            var end = step(p, 0.82, 0.9);
            if (cta) {
                cta.style.opacity = String(end);
                cta.style.transform = "translate(-50%, " + (1 - end) * 12 + "px)";
                cta.style.pointerEvents = end > 0.5 ? "auto" : "none";
            }
            if (note) note.style.opacity = String(1 - morphAll);
            if (count) count.style.opacity = String(1 - morphAll);
        }

        function onScroll() {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }
        layout();
        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", function () { layout(); onScroll(); });
    })();
</script>

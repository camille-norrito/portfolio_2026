---
// src/components/ContactSnippet.astro
---

<section
    style="background:#fff;display:flex;align-items:center;padding:4rem;gap:4rem;border-top:1px solid rgba(38,31,28,0.1);"
>
    <!-- GAUCHE : texte -->
    <div style="flex:0 0 48%;display:flex;flex-direction:column;gap:2rem;">
        <h2
            style="font-family:'Montserrat';font-size:90px;font-weight:400;line-height:85%;"
        >
            CONTACTEZ<br />MOI
        </h2>
        <div>
            <a
                href="tel:+33768639449"
                class="contact-link"
                style="display:block;font-family:'Montserrat';font-size:clamp(12px,1.2vw,16px);font-weight:600;color:#261F1C;text-decoration:none;margin-bottom:0.3rem;transition:color 0.2s;"
            >
                +(33) 7 68 63 94 49
            </a>
            <a
                href="mailto:bacalacamille@icloud.com"
                class="contact-link"
                style="display:block;font-family:'Montserrat';font-size:clamp(12px,1.2vw,16px);font-weight:600;color:#261F1C;text-decoration:none;margin-bottom:1.5rem;transition:color 0.2s;"
            >
                bacalacamille@icloud.com
            </a>
            <a
                href="/contact"
                class="contact-cta"
                style="display:inline-flex;align-items:center;gap:0.6rem;font-family:'Montserrat';font-size:9px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#F5F0EA;background:#261F1C;padding:10px 20px;border-radius:30px;text-decoration:none;transition:background 0.3s;"
            >
                Allez à la page contact
                <svg
                    width="10"
                    height="10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                >
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
            </a>
        </div>
    </div>


</section>

<style>
    .contact-link:hover {
        color: #b50d0b !important;
    }
    .contact-cta:hover {
        background: #b50d0b !important;
    }
</style>

---
// Header.astro
import Logo_noir from "../assets/icons/Logo.svg";
---

<header
    id="main-header"
    style="position:fixed;top:0;left:0;right:0;z-index:50;mix-blend-mode:normal;opacity:0;transition:opacity 0.6s ease;"
>
    <!-- BARRE PRINCIPALE -->
    <div
        id="header-bar"
        style="display:flex;align-items:center;justify-content:space-between;padding:0 2.5rem;height:56px;transition:background 0.4s ease, border-color 0.4s ease;border-bottom:1px solid transparent;"
    >
        <!-- GAUCHE : numéro + logo -->
        <div style="display:flex;align-items:center;gap:1.2rem;">
            <a
                href="/"
                style="display:flex;align-items:center;text-decoration:none;"
            >
                <img
                    id="hd-logo"
                    src={Logo_noir.src}
                    alt="Camille Norrito"
                    style="height:22px;width:auto;filter:brightness(0);transition:filter 0.4s;"
                />
            </a>
        </div>

        <!-- CENTRE : nav links -->
        <nav style="display:flex;align-items:center;gap:2.5rem;">
            <a
                href="/projets"
                class="hd-link"
                style="font-family:'Montserrat';font-size:10px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#261F1C;text-decoration:none;position:relative;transition:color 0.3s;"
            >
                Projets
            </a>
            <a
                href="/a-propos"
                class="hd-link"
                style="font-family:'Montserrat';font-size:10px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#261F1C;text-decoration:none;position:relative;transition:color 0.3s;"
            >
                À propos
            </a>
            <a
                href="/contact"
                class="hd-link"
                style="font-family:'Montserrat';font-size:10px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:#261F1C;text-decoration:none;position:relative;transition:color 0.3s;"
            >
                Contact
            </a>
        </nav>

        <!-- DROITE : CV + indicateur scroll -->
        <div style="display:flex;align-items:center;gap:1.5rem;">
            <!-- Barre de scroll -->
            <div style="display:flex;align-items:center;gap:8px;">
                <div
                    style="width:40px;height:1px;background:rgba(38,31,28,0.12);position:relative;overflow:hidden;"
                >
                    <div
                        id="hd-scroll-bar"
                        style="position:absolute;left:0;top:0;height:100%;width:0%;background:#B50D0B;transition:width 0.1s linear;"
                    >
                    </div>
                </div>
                <span
                    id="hd-scroll-pct"
                    style="font-family:'Montserrat';font-size:8px;letter-spacing:0.15em;color:rgba(38,31,28,0.3);min-width:24px;"
                    >00%</span
                >
            </div>
            <!-- Bouton CV -->
            <a
                href="/cv.pdf"
                download
                style="font-family:'Montserrat';font-size:9px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#261F1C;text-decoration:none;border:1px solid rgba(38,31,28,0.3);padding:6px 14px;border-radius:20px;transition:background 0.3s,color 0.3s,border-color 0.3s;"
                id="hd-cv"
            >
                Télécharger CV ↓
            </a>
        </div>
    </div>

    <!-- LIGNE ROUGE en bas (animée au chargement) -->
    <div
        id="hd-redline"
        style="height:1px;background:#B50D0B;width:0%;transition:width 1s 0.3s cubic-bezier(0.16,1,0.3,1);"
    >
    </div>
</header>

<style>
    .hd-link::after {
        content: "";
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 1px;
        background: #b50d0b;
        transition: width 0.3s ease;
    }
    .hd-link:hover::after {
        width: 100%;
    }
    .hd-link:hover {
        color: #b50d0b !important;
    }
    #hd-cv:hover {
        background: #261f1c !important;
        color: white !important;
        border-color: #261f1c !important;
    }
</style>

<script>
    (function () {
        var bar = document.getElementById("header-bar");
        var redline = document.getElementById("hd-redline");
        var scrollB = document.getElementById("hd-scroll-bar");
        var scrollP = document.getElementById("hd-scroll-pct");
        var logo = document.getElementById("hd-logo");
        var num = document.getElementById("hd-num");

        // Ligne rouge au chargement
        setTimeout(function () {
            if (redline) redline.style.width = "100%";
        }, 100);

        // Scroll : fond + barre progression
        var isScrolled = false;
        window.addEventListener(
            "scroll",
            function () {
                var scrollY = window.scrollY;
                var docH =
                    document.documentElement.scrollHeight - window.innerHeight;
                var pct = docH > 0 ? Math.round((scrollY / docH) * 100) : 0;

                // Barre progression
                if (scrollB) scrollB.style.width = pct + "%";
                if (scrollP)
                    scrollP.textContent = (pct < 10 ? "0" : "") + pct + "%";

                // Fond blanc au scroll
                if (scrollY > 40 && !isScrolled) {
                    isScrolled = true;
                    if (bar) {
                        bar.style.background = "rgba(255,255,255,0.96)";
                        bar.style.borderColor = "rgba(38,31,28,0.08)";
                        bar.style.backdropFilter = "blur(12px)";
                    }
                } else if (scrollY <= 40 && isScrolled) {
                    isScrolled = false;
                    if (bar) {
                        bar.style.background = "transparent";
                        bar.style.borderColor = "transparent";
                        bar.style.backdropFilter = "none";
                    }
                }
            },
            { passive: true },
        );

        // Page active
        var path = window.location.pathname;
        var links = document.querySelectorAll(".hd-link");
        links.forEach(function (l) {
            var href = (l as HTMLAnchorElement).getAttribute("href") || "";
            if (path === href || (href !== "/" && path.startsWith(href))) {
                (l as HTMLElement).style.color = "#B50D0B";
                (l as HTMLElement).style.setProperty("--active", "1");
            }
        });

        // Montrer le Header une fois que le loading est fini
        var mainHeader = document.getElementById("main-header");
        window.addEventListener("loadingComplete", function () {
            if (mainHeader) {
                mainHeader.style.opacity = "1";
            }
        });

        // Fallback : afficher le header après 8 secondes si pas d'événement loadingComplete
        setTimeout(function () {
            if (mainHeader && mainHeader.style.opacity === "0") {
                mainHeader.style.opacity = "1";
            }
        }, 8000);
    })();
</script>

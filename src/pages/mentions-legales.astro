---
// src/pages/mentions-legales.astro
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Mentions Légales - Camille Norrito">

    <main class="bg-white">
        <div class="pt-28 md:pt-32">
            <!-- ===================== MENTIONS LÉGALES ===================== -->
            <section class="px-10 md:px-16 lg:px-20 pb-24">
                <!-- Titre -->
                <h1
                    class="text-[#261F1C] mb-12"
                    style="font-family: 'Horizon'; font-weight: 700; font-size: 45px;"
                >
                    MENTIONS LÉGALES
                </h1>

                <!-- Infos éditeur -->
                <div class="max-w-xl mb-16">
                    <p class="text-content text-brown leading-relaxed">
                        Nom du site : Portfolio – Camille Norrito<br />
                        Responsable de la publication : Camille Norrito<br />
                        Statut : Étudiante en Métiers du Multimédia et de l'Internet
                        (MMI)<br />
                        Contact : camillenorrito.pro@gmail.com<br />
                        Hébergement : Ce site est hébergé par [Nom de l'hébergeur]<br
                        />
                        Adresse : [adresse de l'hébergeur]
                    </p>
                </div>

                <!-- Propriété intellectuelle -->
                <div class="max-w-xl mb-16">
                    <h4 class="text-[#261F1C] mb-4 uppercase">
                        Propriété intellectuelle
                    </h4>
                    <p class="text-content text-brown leading-relaxed">
                        L'ensemble des contenus présents sur ce site (textes,
                        images, vidéos, projets, graphismes, animations) est la
                        propriété de Camille Norrito, sauf mention contraire.<br
                        />
                        Toute reproduction, représentation ou utilisation sans autorisation
                        préalable est interdite.
                    </p>
                </div>

                <!-- Liens externes -->
                <div class="max-w-xl mb-16">
                    <h4 class="text-[#261F1C] mb-4 uppercase">
                        Liens externes
                    </h4>
                    <p class="text-content text-brown leading-relaxed">
                        Ce site peut contenir des liens vers des plateformes
                        externes (Instagram, Behance, LinkedIn, etc.).<br />
                        Je ne suis pas responsable du contenu ou des politiques de
                        confidentialité de ces sites tiers.
                    </p>
                </div>

                <!-- Crédits -->
                <div class="max-w-xl mb-16">
                    <h4 class="text-[#261F1C] mb-4 uppercase">Crédits</h4>
                    <p class="text-content text-brown leading-relaxed">
                        Site conçu et développé par Camille Norrito, dans le
                        cadre de mes études en Métiers du Multimédia et de
                        l'Internet.
                    </p>
                </div>

                <!-- Copyright -->
                <p class="text-content text-brown">
                    © 2026 Camille Norrito. Tous droits réservés.
                </p>
            </section>

            <!-- ===================== POLITIQUES DE CONFIDENTIALITÉ ===================== -->
            <section
                id="politique-confidentialite"
                class="px-10 md:px-16 lg:px-20 pb-24 pt-24"
            >
                <!-- Titre aligné à droite -->
                <div class="flex justify-end mb-20">
                    <h1
                        class="text-[#261F1C] text-right max-w-2xl"
                        style="font-family: 'Horizon'; font-weight: 700; font-size: 45px; line-height: 105%;"
                    >
                        POLITIQUES DE CONFIDENTIALITÉS
                    </h1>
                </div>

                <!-- Contenu aligné à droite -->
                <div class="flex flex-col items-end">
                    <!-- Données personnelles -->
                    <div class="max-w-md mb-16 text-right">
                        <h4 class="text-[#261F1C] mb-6 uppercase">
                            Données personnelles &amp;<br />confidentialité
                        </h4>
                        <p class="text-content text-brown leading-relaxed">
                            Ce site a pour vocation de présenter un portfolio
                            étudiant.<br />
                            Aucune donnée personnelle n'est collectée directement
                            via des formulaires ou des inscriptions.
                        </p>

                        <p class="text-content text-brown leading-relaxed mt-6">
                            Si des outils de mesure d'audience sont utilisés
                            (par exemple Google Analytics), ceux-ci collectent
                            uniquement des données anonymes telles que :
                        </p>

                        <!-- Liste centrée -->
                        <ul class="mt-4 space-y-1">
                            <li class="text-content text-brown">
                                · le type de navigateur
                            </li>
                            <li class="text-content text-brown">
                                · le type d'appareil
                            </li>
                            <li class="text-content text-brown">
                                · les pages consultées
                            </li>
                        </ul>

                        <p class="text-content text-brown leading-relaxed mt-6">
                            Ces données servent uniquement à améliorer
                            l'expérience utilisateur et les performances du
                            site.<br />
                            Aucune donnée personnelle n'est vendue ni partagée à des
                            tiers.
                        </p>
                    </div>

                    <!-- Cookies -->
                    <div class="max-w-md text-right">
                        <h4 class="text-[#261F1C] mb-4 uppercase">Cookies</h4>
                        <p class="text-content text-brown leading-relaxed">
                            Ce site n'utilise pas de cookies.
                        </p>
                    </div>
                </div>
            </section>
        </div>
    </main>
</Layout>

---
// src/pages/gallery/[slug].astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";

const PB_URL = "http://127.0.0.1:8090";

interface Gallery {
    id: string;
    collectionId: string;
    title: string;
    slug: string;
    description: string;
    cover: string;
    photos: string[];
    order: number;
}

const resAll = await fetch(
    `${PB_URL}/api/collections/galleries/records?perPage=50&sort=order`,
);
const dataAll = await resAll.json();
const allGalleries: Gallery[] = dataAll.items || [];

const { slug } = Astro.params;
const resCurrent = await fetch(
    `${PB_URL}/api/collections/galleries/records?filter=(slug='${slug}')`,
);
const dataCurrent = await resCurrent.json();
const gallery: Gallery = dataCurrent.items?.[0];

if (!gallery) {
    return Astro.redirect("/404");
}

const currentIndex = allGalleries.findIndex((g: Gallery) => g.slug === slug);
const nextGallery: Gallery | null =
    allGalleries[currentIndex + 1] || allGalleries[0];

const photoUrl = (filename: string) =>
    `${PB_URL}/api/files/${gallery.collectionId}/${gallery.id}/${filename}`;

const photos = Array.isArray(gallery.photos) ? gallery.photos : [];
const p = (i: number) => (photos[i] ? photoUrl(photos[i]) : "");

const allPhotoUrls = photos.map(photoUrl);
---

<Layout title={`${gallery.title} — Camille Norrito`}>
    <Header />

    <main class="page-main">
        <!-- COLONNE GAUCHE : photos + infos -->
        <div class="photos-col">
            <!-- Rangée 1 -->
            <div class="grid-row row-1">
                <div class="cell cell-large reveal" style="--delay:0.1s">
                    <img
                        src={p(0)}
                        alt={`${gallery.title} 1`}
                        loading="eager"
                        data-index="0"
                        class="lightbox-trigger"
                    />
                </div>
                <div class="cell cell-medium reveal" style="--delay:0.2s">
                    <img
                        src={p(1)}
                        alt={`${gallery.title} 2`}
                        loading="eager"
                        data-index="1"
                        class="lightbox-trigger"
                    />
                </div>
                <div class="cell cell-large reveal" style="--delay:0.3s">
                    <img
                        src={p(2)}
                        alt={`${gallery.title} 3`}
                        loading="eager"
                        data-index="2"
                        class="lightbox-trigger"
                    />
                </div>
                <div class="cell cell-large reveal" style="--delay:0.4s">
                    <img
                        src={p(3)}
                        alt={`${gallery.title} 4`}
                        loading="eager"
                        data-index="3"
                        class="lightbox-trigger"
                    />
                </div>
            </div>

            <!-- Rangée 2 — plus haute -->
            <div class="grid-row row-2">
                <div class="cell cell-small reveal" style="--delay:0.5s">
                    <img
                        src={p(4)}
                        alt={`${gallery.title} 5`}
                        loading="lazy"
                        data-index="4"
                        class="lightbox-trigger"
                    />
                </div>
                <div class="cell cell-small reveal" style="--delay:0.55s">
                    <img
                        src={p(5)}
                        alt={`${gallery.title} 6`}
                        loading="lazy"
                        data-index="5"
                        class="lightbox-trigger"
                    />
                </div>
                <div class="cell cell-medium reveal" style="--delay:0.6s">
                    <img
                        src={p(6)}
                        alt={`${gallery.title} 7`}
                        loading="lazy"
                        data-index="6"
                        class="lightbox-trigger"
                    />
                </div>
                <div class="cell cell-small reveal" style="--delay:0.65s">
                    <img
                        src={p(7)}
                        alt={`${gallery.title} 8`}
                        loading="lazy"
                        data-index="7"
                        class="lightbox-trigger"
                    />
                </div>
                <div class="cell cell-large-wide reveal" style="--delay:0.7s">
                    <img
                        src={p(8)}
                        alt={`${gallery.title} 9`}
                        loading="lazy"
                        data-index="8"
                        class="lightbox-trigger"
                    />
                </div>
            </div>

            <!-- Titre + description + bouton — collé juste sous les photos, 0 marge -->
            <div class="info-row reveal" style="--delay:0.3s">
                <div class="info-left">
                    <h2 class="gallery-title">{gallery.title}</h2>
                    <p class="gallery-desc">{gallery.description}</p>
                </div>
                {
                    nextGallery && (
                        <div class="info-right">
                            <a
                                href={`/gallery/${nextGallery.slug}`}
                                class="next-btn"
                                aria-label="Galerie suivante"
                            >
                                <p class="next-label">GALLERIE</p>
                                <p class="next-name">{nextGallery.title}</p>
                                <div class="next-circle">
                                    <svg
                                        width="16"
                                        height="16"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M5 12h14M13 6l6 6-6 6" />
                                    </svg>
                                </div>
                            </a>
                        </div>
                    )
                }
            </div>
        </div>

        <!-- SIDEBAR DROITE -->
        <div class="sidebar">
            <p class="follow-title">FOLLOW<br />ME ON</p>
            <div class="social-icons">
                <a
                    href="https://instagram.com/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram"
                >
                    <img src="/assets/icons/Icon_insta.svg" alt="Instagram" />
                </a>
                <a
                    href="https://behance.net/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Behance"
                >
                    <img src="/assets/icons/Icon_behance.svg" alt="Behance" />
                </a>
                <a
                    href="https://linkedin.com/in/"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="LinkedIn"
                >
                    <img src="/assets/icons/Icon_linkedin.svg" alt="LinkedIn" />
                </a>
            </div>
        </div>
    </main>

    <!-- LIGHTBOX -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lb-close" aria-label="Fermer"
            >×</button
        >
        <button class="lightbox-prev" id="lb-prev" aria-label="Précédent">
            <svg
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7"></path></svg
            >
        </button>
        <img src="" alt="" id="lb-img" />
        <button class="lightbox-next" id="lb-next" aria-label="Suivant">
            <svg
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"></path></svg
            >
        </button>
    </div>
</Layout>

<style>
    .page-main {
        display: flex;
        width: 100%;
        min-height: 100vh;
        padding-top: 80px;
        background: #fff;
        box-sizing: border-box;
    }

    .photos-col {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 12px 0 32px 12px;
    }

    .grid-row {
        display: flex;
        gap: 4px;
        width: 100%;
    }

    .cell {
        overflow: hidden;
        flex-shrink: 0;
    }
    .cell img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        cursor: pointer;
        transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .cell:hover img {
        transform: scale(1.06);
    }

    /* Rangée 1 — inchangée */
    .row-1 {
        height: clamp(120px, 17vw, 220px);
    }
    .row-1 .cell-large {
        flex: 2.5;
    }
    .row-1 .cell-medium {
        flex: 1.4;
    }

    /* Rangée 2 — agrandie */
    .row-2 {
        height: clamp(130px, 19vw, 260px);
    }
    .row-2 .cell-small {
        flex: 1;
    }
    .row-2 .cell-medium {
        flex: 1.6;
    }
    .row-2 .cell-large-wide {
        flex: 3;
    }

    /* Info row — 0 marge au dessus */
    .info-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 2rem;
        padding: 0 12px 0 0; /* ← 0 en haut */
        margin-top: 0;
        flex: 1;
    }

    .info-left {
        flex: 1;
        min-width: 0;
    }

    .gallery-title {
        font-family: "Montserrat", sans-serif;
        font-size: clamp(60px, 10vw, 100px);
        letter-spacing: 0.02em;
        line-height: 1;
        color: #261f1c;
        text-transform: uppercase;
        margin: 0 0 0.5rem 0;
    }

    .gallery-desc {
        font-family: "Montserrat", sans-serif;
        font-size: clamp(9px, 0.78vw, 11px);
        line-height: 1.85;
        color: #261f1c;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        max-width: none;
        width: 100%;
        margin: 0;
    }

    .info-right {
        flex-shrink: 0;
        display: flex;
        align-items: flex-end;
    }

    .next-btn {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 5px;
        text-decoration: none;
    }
    .next-label {
        font-family: "Montserrat", sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.25em;
        color: #261f1c;
        text-transform: uppercase;
        margin: 0;
    }
    .next-name {
        font-family: "Montserrat", sans-serif;
        font-size: 8px;
        letter-spacing: 0.18em;
        color: rgba(38, 31, 28, 0.45);
        text-transform: uppercase;
        margin: 0;
    }
    .next-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1.5px solid #261f1c;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #261f1c;
        transition: background 0.25s;
        margin-top: 6px;
    }
    .next-btn:hover .next-circle {
        background: #261f1c;
    }
    .next-btn:hover .next-circle svg {
        stroke: #fff;
    }

    .sidebar {
        width: 72px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        border-left: 1px solid rgba(38, 31, 28, 0.13);
        gap: 1.2rem;
        padding: 12px 0 32px;
    }
    .follow-title {
        font-family: "Montserrat", sans-serif;
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.2em;
        color: #261f1c;
        text-transform: uppercase;
        text-align: center;
        line-height: 1.6;
        margin: 0;
    }
    .social-icons {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.1rem;
    }
    .social-icons a {
        opacity: 0.85;
        transition: opacity 0.2s;
        display: flex;
    }
    .social-icons a:hover {
        opacity: 0.4;
    }
    .social-icons img {
        width: 24px;
        height: 24px;
    }

    .lightbox {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.92);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }
    .lightbox.open {
        display: flex;
    }
    .lightbox img {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
    }
    .lightbox-close {
        position: absolute;
        top: 90px;
        right: 24px;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 1.5px solid rgba(255, 255, 255, 0.5);
        background: none;
        color: white;
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        opacity: 0.85;
        transition:
            background 0.2s,
            opacity 0.2s;
    }
    .lightbox-close:hover {
        background: rgba(255, 255, 255, 0.15);
        opacity: 1;
    }
    .lightbox-prev,
    .lightbox-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: 1.5px solid rgba(255, 255, 255, 0.35);
        border-radius: 50%;
        width: 44px;
        height: 44px;
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }
    .lightbox-prev {
        left: 20px;
    }
    .lightbox-next {
        right: 20px;
    }
    .lightbox-prev:hover,
    .lightbox-next:hover {
        background: rgba(255, 255, 255, 0.15);
    }

    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition:
            opacity 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--delay, 0s),
            transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) var(--delay, 0s);
    }
    .reveal.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (max-width: 768px) {
        .page-main {
            flex-direction: column;
        }
        .sidebar {
            width: 100%;
            flex-direction: row;
            justify-content: center;
            border-left: none;
            border-top: 1px solid rgba(38, 31, 28, 0.13);
            padding: 16px;
            gap: 2rem;
        }
        .grid-row {
            flex-wrap: wrap;
            height: auto !important;
        }
        .cell {
            flex: 1 1 45% !important;
            height: 130px;
        }
        .info-row {
            flex-direction: column;
            align-items: flex-start;
        }
        .gallery-title {
            font-size: clamp(38px, 14vw, 72px);
        }
    }
</style>

<script define:vars={{ allPhotoUrls }}>
    document
        .querySelectorAll(".reveal")
        .forEach((el) => el.classList.add("is-visible"));

    const lb = document.getElementById("lightbox");
    const lbImg = document.getElementById("lb-img");
    const lbClose = document.getElementById("lb-close");
    const lbPrev = document.getElementById("lb-prev");
    const lbNext = document.getElementById("lb-next");
    const urls = allPhotoUrls;
    let current = 0;

    function openLb(index) {
        current = index;
        lbImg.src = urls[current] || "";
        lb.classList.add("open");
        document.body.style.overflow = "hidden";
    }
    function closeLb() {
        lb.classList.remove("open");
        document.body.style.overflow = "";
    }
    function showPrev() {
        current = (current - 1 + urls.length) % urls.length;
        lbImg.src = urls[current];
    }
    function showNext() {
        current = (current + 1) % urls.length;
        lbImg.src = urls[current];
    }

    document.querySelectorAll(".lightbox-trigger").forEach((img) => {
        img.addEventListener("click", () => {
            const idx = parseInt(img.getAttribute("data-index") || "0", 10);
            openLb(idx);
        });
    });
    lbClose.addEventListener("click", closeLb);
    lbPrev.addEventListener("click", showPrev);
    lbNext.addEventListener("click", showNext);
    lb.addEventListener("click", (e) => {
        if (e.target === lb) closeLb();
    });
    document.addEventListener("keydown", (e) => {
        if (!lb.classList.contains("open")) return;
        if (e.key === "Escape") closeLb();
        if (e.key === "ArrowLeft") showPrev();
        if (e.key === "ArrowRight") showNext();
    });
</script>

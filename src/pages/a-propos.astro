---
// src/pages/a-propos.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const competences = [
    {
        title: "WEB & UX DESIGN",
        desc: "Conception d'interfaces intuitives et de maquettes orientées utilisateur, de la recherche UX au prototype Figma.",
        toolIcons: [{ name: "Figma", src: "/assets/icons/Icon_Figma.svg" }],
    },
    {
        title: "AUDIOVISUEL & PRODUCTION DE CONTENUS",
        desc: "Production et réalisation de contenus vidéo : tournage, direction artistique, montage et étalonnage.",
        toolIcons: [
            {
                name: "Premiere Pro",
                src: "/assets/icons/Icon_Premiere_Pro.svg",
            },
            { name: "DaVinci", src: "/assets/icons/Icon_DaVinci.svg" },
        ],
    },
    {
        title: "SOUND DESIGN & PODCAST",
        desc: "Production de projets audio et création d'un podcast en tant que projet personnel.",
        bullets: [
            "Enregistrement et gestion du son",
            "Sound design et création de samplers",
            "Doublage en anglais",
            "Réglages audio avant enregistrement",
        ],
        toolIcons: [
            { name: "Audition", src: "/assets/icons/Icon_Audition.svg" },
        ],
    },
    {
        title: "MOTION DESIGN",
        desc: "Création d'animations pour enrichir les projets visuels et audiovisuels.",
        bullets: [
            "Animation de logos et éléments graphiques",
            "Intégration du motion dans une direction artistique",
        ],
        toolIcons: [
            {
                name: "After Effect",
                src: "/assets/icons/Icon_After_Effect.svg",
            },
        ],
    },
    {
        title: "MONTAGE VIDEO",
        desc: "Réalisation et montage de contenus vidéo pour des projets créatifs et personnels.",
        bullets: [
            "Montage vidéo et narration visuelle",
            "Travail du rythme et de la cohérence esthétique",
            "Valorisation des contenus par le montage",
        ],
        toolIcons: [
            {
                name: "Premiere Pro",
                src: "/assets/icons/Icon_Premiere_Pro.svg",
            },
            { name: "DaVinci", src: "/assets/icons/Icon_DaVinci.svg" },
        ],
    },
    {
        title: "PHOTOGRAPHIE & DIRECTION DE SHOOTING",
        desc: "Gestion complète de shootings photo, de la préparation à la réalisation.",
        bullets: [
            "Prise de vue",
            "Réflexion autour de la scénographie et d'une ambiance cohérente",
            "Travail des lumières et du cadrage",
            "Organisation de l'événement, logistique et gestion du stress",
        ],
        toolIcons: [
            { name: "Photoshop", src: "/assets/icons/Icon_Photoshop.svg" },
        ],
    },
    {
        title: "SOCIAL MEDIA & CONTENUS DIGITAUX",
        desc: "Création de contenus visuels pensés pour les réseaux sociaux et leur impact.",
        bullets: [
            "Création d'une stratégie de communication",
            "Création des visuels et campagnes Instagram / TikTok",
            "Conception de stories et formats engageants",
            "Gestion de contenus sur Behance et LinkedIn",
            "Maintien d'une cohérence visuelle digitale",
        ],
        toolIcons: [
            { name: "Figma", src: "/assets/icons/Icon_Figma.svg" },
            { name: "Illustrator", src: "/assets/icons/Icon_Illustrator.svg" },
        ],
    },
    {
        title: "DESIGN GRAPHIQUE & COMMUNICATION",
        desc: "Conception de supports visuels print et digitaux avec une attention portée au sens et à la lisibilité.",
        bullets: [
            "Création de visuels graphiques multi-supports",
            "Travail sur la hiérarchie visuelle et la mise en page",
            "Adaptation des contenus aux supports digitaux",
            "Approche orientée UX visuelle",
        ],
        toolIcons: [
            { name: "Illustrator", src: "/assets/icons/Icon_Illustrator.svg" },
            { name: "InDesign", src: "/assets/icons/Icon_Indesign.svg" },
            { name: "Photoshop", src: "/assets/icons/Icon_Photoshop.svg" },
        ],
    },
    {
        title: "BRANDING & IDENTITE VISUELLE",
        desc: "Création et développement d'univers de marque cohérents, de la réflexion stratégique à la direction artistique.",
        bullets: [
            "Définition de l'identité de marque, des valeurs et du positionnement",
            "Élaboration de directions artistiques adaptées au concept",
            "Création de logos et d'identités visuelles",
            "Conception de visuels produits et merchandising",
            "Déclinaison de l'univers sur différents supports de communication",
        ],
        toolIcons: [
            { name: "Illustrator", src: "/assets/icons/Icon_Illustrator.svg" },
            { name: "InDesign", src: "/assets/icons/Icon_Indesign.svg" },
            { name: "Photoshop", src: "/assets/icons/Icon_Photoshop.svg" },
            { name: "Figma", src: "/assets/icons/Icon_Figma.svg" },
        ],
    },
];
---

<Layout title="A Propos - Camille Norrito">
    <Header />

    <main class="bg-white pt-28 md:pt-32 overflow-x-hidden">
        <!-- S1 : TITRE -->
        <section class="w-full overflow-hidden pb-0">
            <h1
                class="text-[#261F1C] uppercase leading-[85%] w-full px-4 md:px-4"
                style="font-family:'Horizon';font-weight:700;font-size:clamp(60px,13.1vw,178px);letter-spacing:-0.02em;white-space:nowrap;"
            >
                À PROPOS
            </h1>
        </section>

        <!-- S2 : INTRO -->
        <section
            class="px-6 md:px-10 lg:px-16 py-10 max-w-2xl mx-auto text-center"
        >
            <p
                class="text-content text-brown"
                style="font-size:13px;line-height:1.6;"
            >
                Je m'appelle <strong>Camille Norrito</strong>, je suis etudiante
                en deuxieme annee en Metiers du Multimedia et de l'Internet a
                Montbeliard. Je m'interesse au
                <strong>design graphique</strong>, au <strong>branding</strong>,
                au <strong>motion design</strong> et a la creation de contenus <strong
                    >audiovisuels</strong
                >.<br /><br />
                J'aime imaginer et creer des univers visuels varies, en accord avec
                une identite, des valeurs et une intention.
            </p>
        </section>

        <!-- S3 : PHOTO + ANNOTATIONS DESKTOP -->
        <section
            id="about-section"
            class="relative px-6 md:px-10 lg:px-16 py-10 min-h-[600px] flex items-center justify-center"
        >
            <div
                id="about-left-text"
                class="hidden lg:block absolute left-10 top-1/2 -translate-y-1/4 max-w-[200px]"
                style="opacity:0;transform:translateX(-16px);transition:opacity 0.6s 0.7s ease, transform 0.6s 0.7s ease;"
            >
                <p
                    class="text-brown uppercase font-bold mb-2"
                    style="font-family:'Montserrat';font-size:11px;font-weight:700;letter-spacing:0.08em;"
                >
                    ETAT D'ESPRIT
                </p>
                <p
                    class="text-brown"
                    style="font-family:'Montserrat';font-size:11px;line-height:1.6;"
                >
                    Je suis curieuse, j'aime explorer plusieurs domaines. Je
                    m'inspire beaucoup de mes voyages, des musees, des
                    expositions et du travail d'artistes que j'admire. J'aime
                    tester, essayer differents styles. Travailler avec d'autres
                    personnes m'aide a aller plus loin dans mes projets.
                </p>
            </div>

            <div
                id="about-line-left"
                class="hidden lg:block absolute top-[47%] h-px bg-[#261F1C] origin-right"
                style="left:210px;width:calc(50% - 280px);transform:scaleX(0);transition:transform 0.5s 0.2s ease;"
            >
            </div>

            <div
                id="about-photo"
                class="relative z-10 w-[220px] md:w-[260px]"
                style="opacity:0;transform:translateY(20px);transition:opacity 0.6s ease, transform 0.6s ease;"
            >
                <img
                    src="/assets/img/ticket_caisse.png"
                    alt="Camille Norrito"
                    class="w-full object-cover"
                />
            </div>

            <div
                id="about-line-right"
                class="hidden lg:block absolute top-[35%] h-px bg-[#261F1C] origin-left"
                style="right:310px;width:calc(50% - 310px);transform:scaleX(0);transition:transform 0.5s 0.2s ease;"
            >
            </div>

            <div
                id="about-right-text"
                class="hidden lg:block absolute right-10 top-1/4 max-w-[220px]"
                style="opacity:0;transform:translateX(16px);transition:opacity 0.6s 0.7s ease, transform 0.6s 0.7s ease;"
            >
                <p
                    class="text-brown uppercase font-bold mb-1"
                    style="font-family:'Montserrat';font-size:11px;font-weight:700;letter-spacing:0.08em;"
                >
                    STAGE DE MARS A JUIN
                </p>
                <p
                    class="text-brown mb-3"
                    style="font-family:'Montserrat';font-size:11px;line-height:1.6;"
                >
                    <strong>Disponibilite :</strong><br />A partir du 30 mars au
                    5 juin 2026
                </p>
                <p
                    class="text-brown mb-1"
                    style="font-family:'Montserrat';font-size:11px;font-weight:700;"
                >
                    Domaines :
                </p>
                <p
                    class="text-brown mb-4"
                    style="font-family:'Montserrat';font-size:11px;line-height:1.8;"
                >
                    Design graphique<br />Branding<br />Motion design<br
                    />Creation de contenus visuels
                </p>
                <a
                    href="/contact"
                    class="inline-block bg-[#261F1C] text-white px-4 py-2 hover:bg-[#B50D0B] transition-colors duration-300 rounded-full"
                    style="font-family:'Montserrat';font-size:11px;font-weight:600;letter-spacing:0.1em;"
                    >CONTACTEZ MOI</a
                >
            </div>
        </section>

        <!-- Mobile annotations -->
        <section class="lg:hidden px-6 py-8 grid grid-cols-1 gap-8">
            <div>
                <p
                    class="text-brown uppercase font-bold mb-2"
                    style="font-family:'Montserrat';font-size:12px;font-weight:700;letter-spacing:0.08em;"
                >
                    ETAT D'ESPRIT
                </p>
                <p
                    class="text-brown"
                    style="font-family:'Montserrat';font-size:12px;line-height:1.6;"
                >
                    Je suis curieuse, j'aime explorer plusieurs domaines. Je
                    m'inspire beaucoup de mes voyages et des expositions.
                </p>
            </div>
            <div>
                <p
                    class="text-brown uppercase font-bold mb-1"
                    style="font-family:'Montserrat';font-size:12px;font-weight:700;letter-spacing:0.08em;"
                >
                    STAGE DE MARS A JUIN
                </p>
                <p
                    class="text-brown mb-3"
                    style="font-family:'Montserrat';font-size:12px;line-height:1.6;"
                >
                    <strong>Disponibilite :</strong> 30 mars au 5 juin 2026<br
                    /><br />
                    <strong>Domaines :</strong> Design graphique, Branding, Motion
                    design, Contenus visuels
                </p>
                <a
                    href="/contact"
                    class="inline-block bg-[#261F1C] text-white px-4 py-2 hover:bg-[#B50D0B] transition-colors duration-300"
                    style="font-family:'Montserrat';font-size:11px;font-weight:600;letter-spacing:0.1em;"
                    >CONTACTEZ MOI</a
                >
            </div>
        </section>

        <!-- S4 : PARCOURS -->
        <section
            id="parcours-section"
            class="relative w-full py-32 bg-white overflow-hidden"
        >
            <div class="px-6 md:px-16 mb-20">
                <p
                    style="font-family:'Montserrat';font-size:10px;font-weight:700;letter-spacing:0.25em;color:#B50D0B;text-transform:uppercase;margin-bottom:0.5rem;"
                >
                    MON PARCOURS
                </p>
                <h2
                    style="font-family:'Horizon';font-size:clamp(32px,5vw,64px);color:#261F1C;letter-spacing:-0.01em;line-height:1;"
                >
                    TIMELINE
                </h2>
            </div>

            <div class="relative px-6 md:px-16 max-w-5xl mx-auto">
                <div
                    class="absolute left-6 md:left-16 right-6 md:right-16"
                    style="top:12px;height:1px;background:rgba(38,31,28,0.12);"
                >
                </div>
                <div
                    id="parcours-line"
                    style="position:absolute;left:0;top:12px;height:1px;background:#B50D0B;width:0%;transition:width 0.05s linear;will-change:width;"
                >
                </div>

                <div
                    class="relative flex justify-between items-start"
                    style="gap:0;"
                >
                    <!-- 2023 — Césure -->
                    <div
                        class="parcours-item flex flex-col items-center"
                        style="flex:1;max-width:220px;"
                    >
                        <div
                            id="dot-0"
                            style="width:24px;height:24px;border-radius:50%;border:2px solid #261F1C;background:white;display:flex;align-items:center;justify-content:center;position:relative;z-index:2;transition:background 0.3s,border-color 0.3s;flex-shrink:0;"
                        >
                            <div
                                style="width:6px;height:6px;border-radius:50%;background:#261F1C;transition:background 0.3s;"
                            >
                            </div>
                        </div>
                        <div
                            id="content-0"
                            class="text-center mt-6"
                            style="opacity:0;transform:translateY(12px);transition:opacity 0.5s,transform 0.5s;"
                        >
                            <p
                                style="font-family:'Montserrat';font-size:11px;font-weight:700;letter-spacing:0.15em;color:#B50D0B;text-transform:uppercase;margin-bottom:0.5rem;"
                            >
                                2023
                            </p>
                            <p
                                style="font-family:'Horizon';font-size:clamp(18px,2.5vw,28px);color:#261F1C;line-height:1;margin-bottom:0.75rem;"
                            >
                                Césure
                            </p>
                            <p
                                style="font-family:'Montserrat';font-size:11px;line-height:1.7;color:rgba(38,31,28,0.65);"
                            >
                                6 mois à Vancouver<br />2 mois en Indonésie<br
                                />Anglais niveau B2
                            </p>
                        </div>
                    </div>

                    <!-- 2024 — 1ère année -->
                    <div
                        class="parcours-item flex flex-col items-center"
                        style="flex:1;max-width:220px;"
                    >
                        <div
                            id="dot-1"
                            style="width:24px;height:24px;border-radius:50%;border:2px solid #261F1C;background:white;display:flex;align-items:center;justify-content:center;position:relative;z-index:2;transition:background 0.3s,border-color 0.3s;flex-shrink:0;"
                        >
                            <div
                                style="width:6px;height:6px;border-radius:50%;background:#261F1C;transition:background 0.3s;"
                            >
                            </div>
                        </div>
                        <div
                            id="content-1"
                            class="text-center mt-6"
                            style="opacity:0;transform:translateY(12px);transition:opacity 0.5s 0.1s,transform 0.5s 0.1s;"
                        >
                            <p
                                style="font-family:'Montserrat';font-size:11px;font-weight:700;letter-spacing:0.15em;color:#B50D0B;text-transform:uppercase;margin-bottom:0.5rem;"
                            >
                                2024
                            </p>
                            <p
                                style="font-family:'Horizon';font-size:clamp(18px,2.5vw,28px);color:#261F1C;line-height:1;margin-bottom:0.75rem;"
                            >
                                1ère année
                            </p>
                            <p
                                style="font-family:'Montserrat';font-size:11px;line-height:1.7;color:rgba(38,31,28,0.65);"
                            >
                                MMI<br />à Montbéliard
                            </p>
                        </div>
                    </div>

                    <!-- 2025 — 2ème année -->
                    <div
                        class="parcours-item flex flex-col items-center"
                        style="flex:1;max-width:220px;"
                    >
                        <div
                            id="dot-2"
                            style="width:24px;height:24px;border-radius:50%;border:2px solid #261F1C;background:white;display:flex;align-items:center;justify-content:center;position:relative;z-index:2;transition:background 0.3s,border-color 0.3s;flex-shrink:0;"
                        >
                            <div
                                style="width:6px;height:6px;border-radius:50%;background:#261F1C;transition:background 0.3s;"
                            >
                            </div>
                        </div>
                        <div
                            id="content-2"
                            class="text-center mt-6"
                            style="opacity:0;transform:translateY(12px);transition:opacity 0.5s 0.2s,transform 0.5s 0.2s;"
                        >
                            <p
                                style="font-family:'Montserrat';font-size:11px;font-weight:700;letter-spacing:0.15em;color:#B50D0B;text-transform:uppercase;margin-bottom:0.5rem;"
                            >
                                2025
                            </p>
                            <p
                                style="font-family:'Horizon';font-size:clamp(18px,2.5vw,28px);color:#261F1C;line-height:1;margin-bottom:0.75rem;"
                            >
                                2ème année
                            </p>
                            <p
                                style="font-family:'Montserrat';font-size:11px;line-height:1.7;color:rgba(38,31,28,0.65);"
                            >
                                MMI à Montbéliard
                            </p>
                        </div>
                    </div>

                    <!-- Mobilité -->
                    <div
                        class="parcours-item flex flex-col items-center"
                        style="flex:1;max-width:220px;"
                    >
                        <div
                            id="dot-3"
                            style="width:24px;height:24px;border-radius:50%;border:2px solid #261F1C;background:white;display:flex;align-items:center;justify-content:center;position:relative;z-index:2;transition:background 0.3s,border-color 0.3s;flex-shrink:0;"
                        >
                            <div
                                style="width:6px;height:6px;border-radius:50%;background:#261F1C;transition:background 0.3s;"
                            >
                            </div>
                        </div>
                        <div
                            id="content-3"
                            class="text-center mt-6"
                            style="opacity:0;transform:translateY(12px);transition:opacity 0.5s 0.3s,transform 0.5s 0.3s;"
                        >
                            <p
                                style="font-family:'Montserrat';font-size:11px;font-weight:700;letter-spacing:0.15em;color:#B50D0B;text-transform:uppercase;margin-bottom:0.5rem;"
                            >
                                Août — Déc 2025
                            </p>
                            <p
                                style="font-family:'Horizon';font-size:clamp(18px,2.5vw,28px);color:#261F1C;line-height:1;margin-bottom:0.75rem;"
                            >
                                Mobilité
                            </p>
                            <p
                                style="font-family:'Montserrat';font-size:11px;line-height:1.7;color:rgba(38,31,28,0.65);"
                            >
                                5 mois au Cégep<br />Vanier College<br
                                />Montréal<br /><span
                                    style="font-style:italic;opacity:0.8;"
                                    >École anglo-saxonne</span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- S5 : COMPETENCES — scroll lock + accordéon -->
        <div id="competences-wrapper" style="position:relative;">
            <section
                id="competences-section"
                class="bg-[#161110]"
                style="position:sticky;top:0;height:100vh;display:flex;flex-direction:column;overflow:hidden;"
            >
                <div
                    class="flex-1 flex flex-col justify-center px-6 md:px-10 lg:px-16 py-10 min-h-0"
                >
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 h-full">
                        <div
                            class="border-t border-white/20 self-start"
                            id="accordion-list"
                        >
                            {
                                competences.map((item, i) => (
                                    <div
                                        class="accordion-item border-b border-white/20 py-4 px-2 flex justify-between items-center cursor-pointer"
                                        data-index={i}
                                    >
                                        <span
                                            class="accordion-label font-bold transition-colors duration-300"
                                            style="font-family:'Montserrat';font-size:13px;font-weight:700;letter-spacing:0.05em;line-height:1.3;color:rgba(255,255,255,0.35);"
                                        >
                                            {item.title}
                                        </span>
                                        <span
                                            class="accordion-num flex-shrink-0 ml-4 transition-colors duration-300"
                                            style="font-family:'Montserrat';font-size:10px;letter-spacing:0.1em;color:rgba(255,255,255,0.18);"
                                        >
                                            0{i + 1}
                                        </span>
                                    </div>
                                ))
                            }
                        </div>
                        <div
                            class="lg:pl-12 lg:border-t border-white/20 flex flex-col justify-center"
                            id="accordion-content"
                            style="transition:opacity 0.35s ease, transform 0.35s ease;"
                        >
                        </div>
                    </div>
                </div>

                <div
                    class="flex-shrink-0 border-t border-white/10 flex items-center gap-6 md:gap-10 px-6 md:px-16 py-5"
                    style="background:#161110;"
                >
                    <span class="text-white numero-2 leading-none">09</span>
                    <h2
                        class="text-white uppercase flex-1"
                        style="font-family:'Montserrat';font-size:clamp(60px,10vw,90px);letter-spacing:0.02em;line-height:1;color:white;text-transform:uppercase;flex:1;text-align:right;"
                    >
                        COMPETENCES
                    </h2>
                    <div class="hidden lg:flex items-center gap-3">
                        <span
                            id="comp-current"
                            style="font-family:'Montserrat';font-size:11px;color:white;letter-spacing:0.1em;"
                            >01</span
                        >
                        <div
                            style="width:80px;height:1px;background:rgba(255,255,255,0.15);position:relative;"
                        >
                            <div
                                id="comp-progress-bar"
                                style="position:absolute;left:0;top:0;height:100%;background:#B50D0B;transition:width 0.4s ease;width:11.1%;"
                            >
                            </div>
                        </div>
                        <span
                            style="font-family:'Montserrat';font-size:11px;color:rgba(255,255,255,0.3);letter-spacing:0.1em;"
                            >09</span
                        >
                    </div>
                    <div
                        id="comp-hint"
                        style="display:flex;align-items:center;gap:6px;font-family:'Montserrat';font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(255,255,255,0.22);transition:opacity 0.6s;"
                    >
                        <span>Scroll</span>
                        <svg
                            width="13"
                            height="13"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            viewBox="0 0 24 24"
                            ><path d="M12 5v14M5 12l7 7 7-7"></path></svg
                        >
                    </div>
                </div>
            </section>
        </div>

        <!-- S6 : OUTILS -->
        <section class="px-6 md:px-16 py-16">
            <h4 class="text-center text-brown uppercase mb-10">OUTILS</h4>
            <div class="flex flex-wrap justify-center gap-8 mb-8">
                {
                    [
                        {
                            name: "After Effect",
                            src: "/assets/icons/Icon_After_Effect.svg",
                        },
                        {
                            name: "Audition",
                            src: "/assets/icons/Icon_Audition.svg",
                        },
                        {
                            name: "Illustrator",
                            src: "/assets/icons/Icon_Illustrator.svg",
                        },
                        {
                            name: "InDesign",
                            src: "/assets/icons/Icon_Indesign.svg",
                        },
                        {
                            name: "Photoshop",
                            src: "/assets/icons/Icon_Photoshop.svg",
                        },
                        {
                            name: "Premiere Pro",
                            src: "/assets/icons/Icon_Premiere_Pro.svg",
                        },
                        { name: "Figma", src: "/assets/icons/Icon_Figma.svg" },
                    ].map((t) => (
                        <div class="flex flex-col items-center gap-2">
                            <img src={t.src} alt={t.name} class="w-12 h-12" />
                            <span style="font-family:'Montserrat';font-size:10px;text-align:center;color:#261F1C;">
                                {t.name}
                            </span>
                        </div>
                    ))
                }
            </div>
            <div class="flex flex-wrap justify-center gap-8">
                {
                    [
                        {
                            name: "DaVinci",
                            src: "/assets/icons/Icon_DaVinci.svg",
                        },
                        { name: "CSS", src: "/assets/icons/Icon_css.svg" },
                        {
                            name: "JavaScript",
                            src: "/assets/icons/Icon_Js.svg",
                        },
                        {
                            name: "Notion",
                            src: "/assets/icons/Icon_Notion.svg",
                        },
                    ].map((t) => (
                        <div class="flex flex-col items-center gap-2">
                            <img src={t.src} alt={t.name} class="w-12 h-12" />
                            <span style="font-family:'Montserrat';font-size:10px;text-align:center;color:#261F1C;">
                                {t.name}
                            </span>
                        </div>
                    ))
                }
            </div>
        </section>
    </main>
</Layout>

<script define:vars={{ competences }}>
    // ══════════════════════════════════════
    //  ABOUT SECTION — REVEAL ANIMATION
    // ══════════════════════════════════════
    (function () {
        var photo = document.getElementById("about-photo");
        var lineLeft = document.getElementById("about-line-left");
        var lineRight = document.getElementById("about-line-right");
        var textLeft = document.getElementById("about-left-text");
        var textRight = document.getElementById("about-right-text");
        if (!photo) return;
        var triggered = false;
        function triggerReveal() {
            if (triggered) return;
            triggered = true;
            photo.style.opacity = "1";
            photo.style.transform = "translateY(0)";
            setTimeout(function () {
                if (lineLeft) lineLeft.style.transform = "scaleX(1)";
                if (lineRight) lineRight.style.transform = "scaleX(1)";
            }, 200);
            setTimeout(function () {
                if (textLeft) {
                    textLeft.style.opacity = "1";
                    textLeft.style.transform = "translateX(0)";
                }
                if (textRight) {
                    textRight.style.opacity = "1";
                    textRight.style.transform = "translateX(0)";
                }
            }, 700);
        }
        var observer = new IntersectionObserver(
            function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        triggerReveal();
                        observer.disconnect();
                    }
                });
            },
            { threshold: 0.5 },
        );
        observer.observe(photo);
    })();

    // ══════════════════════════════════════
    //  PARCOURS — LIGNE ANIMÉE AU SCROLL
    // ══════════════════════════════════════
    (function () {
        var section = document.getElementById("parcours-section");
        var line = document.getElementById("parcours-line");
        var dots = [
            document.getElementById("dot-0"),
            document.getElementById("dot-1"),
            document.getElementById("dot-2"),
            document.getElementById("dot-3"),
        ];
        var contents = [
            document.getElementById("content-0"),
            document.getElementById("content-1"),
            document.getElementById("content-2"),
            document.getElementById("content-3"),
        ];
        if (!section || !line) return;
        var dotPositions = [0, 0.33, 0.66, 1];
        var dotRevealed = [false, false, false, false];

        function calibrate() {
            var dot0 = document.getElementById("dot-0");
            var dot3 = document.getElementById("dot-3");
            if (!dot0 || !dot3 || !line) return;
            var sRect = section.getBoundingClientRect();
            var d0Rect = dot0.getBoundingClientRect();
            var d3Rect = dot3.getBoundingClientRect();
            line.style.left =
                d0Rect.left + d0Rect.width / 2 - sRect.left + "px";
            line.style.right = "auto";
            line.setAttribute(
                "data-total-w",
                d3Rect.left +
                    d3Rect.width / 2 -
                    (d0Rect.left + d0Rect.width / 2),
            );
        }

        function updateWithCalibration() {
            var rect = section.getBoundingClientRect();
            var vh = window.innerHeight;
            var start = rect.top - vh * 0.5;
            var end = rect.top - vh * 0.05;
            var progress = Math.min(
                1,
                Math.max(0, -start / (end - start + 0.001)),
            );
            var totalW = parseFloat(line.getAttribute("data-total-w") || 0);
            line.style.width = progress * totalW + "px";
            for (var i = 0; i < 4; i++) {
                if (progress >= dotPositions[i] - 0.03 && !dotRevealed[i]) {
                    dotRevealed[i] = true;
                    if (dots[i]) {
                        dots[i].style.background = "#B50D0B";
                        dots[i].style.borderColor = "#B50D0B";
                        var inner = dots[i].querySelector("div");
                        if (inner) inner.style.background = "white";
                    }
                    if (contents[i]) {
                        contents[i].style.opacity = "1";
                        contents[i].style.transform = "translateY(0)";
                    }
                }
            }
        }

        var ticking = false;
        window.addEventListener(
            "scroll",
            function () {
                if (!ticking) {
                    requestAnimationFrame(function () {
                        calibrate();
                        updateWithCalibration();
                        ticking = false;
                    });
                    ticking = true;
                }
            },
            { passive: true },
        );
        window.addEventListener("load", function () {
            calibrate();
            updateWithCalibration();
        });
        window.addEventListener("resize", function () {
            calibrate();
            updateWithCalibration();
        });
        setTimeout(function () {
            calibrate();
            updateWithCalibration();
        }, 150);
    })();

    // ══════════════════════════════════════
    //  COMPETENCES — SCROLL LOCK + ACCORDION
    // ══════════════════════════════════════
    (function () {
        var section = document.getElementById("competences-section");
        var items = document.querySelectorAll(".accordion-item");
        var contentZone = document.getElementById("accordion-content");
        var progBar = document.getElementById("comp-progress-bar");
        var currentNum = document.getElementById("comp-current");
        var hint = document.getElementById("comp-hint");
        if (!section || !items.length) return;
        var activeIndex = 0;
        var locked = false;
        var savedScrollY = 0;
        var touchStartY = 0;
        var hintHidden = false;
        var total = competences.length;

        function renderContent(i) {
            var c = competences[i];
            if (!contentZone) return;
            var html =
                "<p style=\"font-family:'Montserrat';font-size:12px;line-height:1.9;color:rgba(255,255,255,0.65);margin-bottom:1.5rem;max-width:360px;\">" +
                c.desc +
                "</p>";
            if (c.bullets && c.bullets.length) {
                html +=
                    "<ul style=\"font-family:'Montserrat';font-size:12px;line-height:1.9;color:rgba(255,255,255,0.5);margin-bottom:2rem;padding-left:16px;list-style:disc;max-width:360px;\">";
                for (var b = 0; b < c.bullets.length; b++) {
                    html += "<li>" + c.bullets[b] + "</li>";
                }
                html += "</ul>";
            }
            html +=
                "<p style=\"font-family:'Montserrat';font-size:11px;font-weight:700;letter-spacing:0.12em;color:rgba(255,255,255,0.4);margin-bottom:1rem;text-transform:uppercase;\">Outils :</p>";
            html += '<div style="display:flex;gap:10px;flex-wrap:wrap;">';
            for (var t = 0; t < c.toolIcons.length; t++) {
                var ic = c.toolIcons[t];
                html +=
                    '<div style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,0.15);border-radius:6px;"><img src="' +
                    ic.src +
                    '" alt="' +
                    ic.name +
                    '" style="width:22px;height:22px;opacity:0.85;"/></div>';
            }
            html += "</div>";
            contentZone.style.opacity = "0";
            contentZone.style.transform = "translateY(10px)";
            contentZone.innerHTML = html;
            requestAnimationFrame(function () {
                contentZone.style.transition =
                    "opacity 0.35s ease, transform 0.35s ease";
                contentZone.style.opacity = "1";
                contentZone.style.transform = "translateY(0)";
            });
        }

        function setActive(i) {
            i = Math.max(0, Math.min(total - 1, i));
            for (var j = 0; j < items.length; j++) {
                var label = items[j].querySelector(".accordion-label");
                var num = items[j].querySelector(".accordion-num");
                if (j === i) {
                    items[j].style.background = "rgba(255,255,255,0.04)";
                    if (label) label.style.color = "white";
                    if (num) num.style.color = "#B50D0B";
                } else {
                    items[j].style.background = "";
                    if (label) label.style.color = "rgba(255,255,255,0.35)";
                    if (num) num.style.color = "rgba(255,255,255,0.18)";
                }
            }
            renderContent(i);
            if (progBar) progBar.style.width = ((i + 1) / total) * 100 + "%";
            if (currentNum)
                currentNum.textContent = (i + 1 < 10 ? "0" : "") + (i + 1);
            activeIndex = i;
        }

        function lock() {
            if (locked) return;
            locked = true;
            savedScrollY = window.scrollY;
            document.body.style.position = "fixed";
            document.body.style.top = "-" + savedScrollY + "px";
            document.body.style.left = "0";
            document.body.style.width = "100%";
            document.body.style.overflowY = "scroll";
        }
        function unlock() {
            if (!locked) return;
            locked = false;
            document.body.style.position = "";
            document.body.style.top = "";
            document.body.style.left = "";
            document.body.style.width = "";
            document.body.style.overflowY = "";
            window.scrollTo(0, savedScrollY);
        }

        function next() {
            if (!hintHidden && hint) {
                hint.style.opacity = "0";
                hintHidden = true;
            }
            if (activeIndex < total - 1) {
                setActive(activeIndex + 1);
            } else {
                unlock();
            }
        }
        function prev() {
            if (activeIndex > 0) {
                setActive(activeIndex - 1);
            } else {
                unlock();
            }
        }

        new IntersectionObserver(
            function (entries) {
                entries.forEach(function (entry) {
                    if (
                        entry.isIntersecting &&
                        entry.intersectionRatio >= 0.99
                    ) {
                        lock();
                    }
                });
            },
            { threshold: 0.99 },
        ).observe(section);

        window.addEventListener(
            "wheel",
            function (e) {
                if (!locked) return;
                e.preventDefault();
                if (e.deltaY > 0) next();
                else prev();
            },
            { passive: false },
        );

        window.addEventListener(
            "touchstart",
            function (e) {
                touchStartY = e.touches[0].clientY;
            },
            { passive: true },
        );
        window.addEventListener(
            "touchend",
            function (e) {
                if (!locked) return;
                var dy = touchStartY - e.changedTouches[0].clientY;
                if (Math.abs(dy) < 30) return;
                if (dy > 0) next();
                else prev();
            },
            { passive: true },
        );

        window.addEventListener("keydown", function (e) {
            if (!locked) return;
            if (e.key === "ArrowDown" || e.key === "ArrowRight") {
                e.preventDefault();
                next();
            }
            if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
                e.preventDefault();
                prev();
            }
        });

        for (var k = 0; k < items.length; k++) {
            (function (idx) {
                items[idx].addEventListener("click", function () {
                    setActive(idx);
                });
            })(k);
        }
        setActive(0);
    })();
</script>

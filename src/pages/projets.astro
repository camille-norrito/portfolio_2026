---
// src/pages/projets.astro
import Layout from "../layouts/Layout.astro";
import { categories, projetsByCategory } from "../data/projets";
import { galleries } from "../data/galleries";

const rows = categories
    .map((c) => ({ ...c, projets: projetsByCategory(c.match) }))
    .filter((r) => r.projets.length > 0);
---

<Layout title="Projets - Camille Norrito">
    <div class="pj-page">
        <!-- SHOWREEL -->
        <div id="pj-reel" class="pj-reel" aria-hidden="true">
            <video id="pj-reel-video" src="/showreel-2027.mp4" autoplay muted loop playsinline preload="auto"></video>
            <div class="pj-reel-shade"></div>
        </div>

        <!-- INTRO -->
        <section class="pj-hero">
            <div id="pj-hint" class="pj-hint" aria-hidden="true">
                <span>Scroll</span>
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
            </div>
            <div class="pj-grid pj-hero-top">
                <h1 class="pj-page-title">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <rect x="6" y="2.5" width="12" height="2.5" rx="1.25"></rect>
                        <rect x="4" y="6.5" width="16" height="2.5" rx="1.25"></rect>
                        <rect x="2.5" y="10.5" width="19" height="11" rx="3"></rect>
                    </svg>
                    Projets
                </h1>
                <div class="pj-hero-meta">
                    <p>Étudiante en 3ème année de BUT MMI à Montbéliard, entre design graphique, branding et motion design.</p>
                    <p>Du concept à la direction artistique finale, chaque projet part d'une intention.</p>
                    <p class="pj-hero-date">Showreel<br />2026</p>
                </div>
            </div>
        </section>

        <!-- PROJETS PAR CATÉGORIE -->
        {rows.map((r) => (
            <section class="pj-grid pj-row" id={"cat-" + r.key}>
                <h2 class="pj-row-label">
                    {r.label}
                    <span>{String(r.projets.length).padStart(2, "0")}</span>
                </h2>
                <div class="pj-track">
                    {r.projets.map((p) => (
                        <a href={"/projets/" + p.slug} class="pj-card">
                            <div class="pj-card-img">
                                {p.cover && <img src={p.cover} alt={p.title.trim()} loading="lazy" />}
                            </div>
                            <p class="pj-card-title">{p.title.trim()}</p>
                            <p class="pj-card-sub">{p.subtitle || p.category[0]}</p>
                        </a>
                    ))}
                </div>
            </section>
        ))}

        <!-- GALERIE -->
        <section class="pj-grid pj-row" id="galerie">
            <h2 class="pj-row-label">
                Galerie
                <span>{String(galleries.length).padStart(2, "0")}</span>
            </h2>
            <div class="pj-track">
                {galleries.map((g) => (
                    <a href={"/gallery/" + g.slug} class="pj-gal-card">
                        {(g.cover || g.photos[0]) && <img src={g.cover || g.photos[0]} alt="" loading="lazy" />}
                        <div class="pj-gal-content">
                            <p class="pj-gal-brand">Galerie photo</p>
                            <p class="pj-gal-title">{g.title}</p>
                            <p class="pj-gal-count">{g.photos.length} photos</p>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </div>
</Layout>

<style is:global>
    /* Fond noir identique au footer : pas d'ombre entre la page et le footer */
    main {
        box-shadow: none !important;
    }
</style>

<style>
    .pj-page {
        --pj-bg: #0e0c0b;
        --pj-text: #f5f0ea;
        --pj-muted: rgba(245, 240, 234, 0.55);
        --pj-line: rgba(245, 240, 234, 0.12);
        --pj-label: clamp(140px, 18vw, 280px);
        position: relative;
        isolation: isolate;
        background: var(--pj-bg);
        color: var(--pj-text);
        padding: 0 2.5rem 6rem;
        font-family: "Montserrat";
    }

    /* ── Showreel ── */
    .pj-reel {
        position: fixed;
        top: 0;
        left: var(--sidebar-w);
        right: 0;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
    }
    .pj-reel video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .pj-reel-shade {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to bottom,
            rgba(14, 12, 11, 0.55) 0%,
            rgba(14, 12, 11, 0.2) 40%,
            rgba(14, 12, 11, 0.85) 100%
        );
    }

    .pj-hero,
    .pj-row {
        position: relative;
        z-index: 1;
    }

    /* ── Grille ── */
    .pj-grid {
        display: grid;
        grid-template-columns: var(--pj-label) minmax(0, 1fr);
        column-gap: 2rem;
    }

    /* ── Intro ── */
    .pj-hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        padding-top: 1.75rem;
    }

    /* Indication « Scroll » en bas de la vidéo d'arrivée */
    .pj-hint {
        position: absolute;
        left: 50%;
        bottom: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--pj-text);
        transform: translateX(-50%);
        transition: opacity 0.4s;
        pointer-events: none;
    }
    .pj-hint svg {
        animation: pj-hint-bounce 1.6s ease-in-out infinite;
    }
    @keyframes pj-hint-bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(6px); }
    }
    @media (prefers-reduced-motion: reduce) {
        .pj-hint svg { animation: none; }
    }
    @media (max-width: 767px) {
        .pj-hint { bottom: 1.5rem; }
    }
    .pj-page-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-family: "Montserrat";
        font-size: 24px;
        font-weight: 500;
        color: var(--pj-text);
        margin: 0;
        align-self: start;
    }
    .pj-hero-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 260px)) 1fr;
        gap: 1.75rem;
        font-size: 15px;
        line-height: 1.45;
    }
    .pj-hero-meta p {
        margin: 0;
    }
    .pj-hero-date {
        text-align: right;
    }
    .pj-hero-main {
        flex: 1;
        align-items: center;
    }
    .pj-headline {
        max-width: 620px;
        font-size: clamp(26px, 2.6vw, 38px);
        font-weight: 500;
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0;
    }

    /* ── Rangées ── */
    .pj-row {
        border-top: 1px solid var(--pj-line);
        padding: 2.25rem 0;
        scroll-margin-top: 1rem;
    }
    .pj-row-label {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        font-family: "Montserrat";
        font-size: 16px;
        font-weight: 600;
        color: var(--pj-text);
        margin: 0;
    }
    .pj-row-label span {
        font-size: 11px;
        font-weight: 500;
        color: var(--pj-muted);
    }
    .pj-track {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        scrollbar-width: none;
    }
    .pj-track::-webkit-scrollbar {
        display: none;
    }

    /* ── Carte projet ── */
    .pj-card {
        flex: 0 0 clamp(180px, 16vw, 250px);
        text-decoration: none;
        color: var(--pj-text);
    }
    .pj-card-img {
        aspect-ratio: 1 / 1;
        border-radius: 16px;
        overflow: hidden;
        background: #1a1614;
        margin-bottom: 0.85rem;
    }
    .pj-card-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .pj-card:hover .pj-card-img img {
        transform: scale(1.04);
    }
    .pj-card-title {
        font-size: 15px;
        font-weight: 500;
        margin: 0;
    }
    .pj-card-sub {
        font-size: 14px;
        color: var(--pj-muted);
        margin: 0.1rem 0 0;
    }

    /* ── Carte galerie ── */
    .pj-gal-card {
        position: relative;
        flex: 0 0 clamp(180px, 16vw, 250px);
        aspect-ratio: 3 / 4;
        border-radius: 16px;
        overflow: hidden;
        background: #1a1614;
        text-decoration: none;
        color: #fff;
    }
    .pj-gal-card img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }
    .pj-gal-card:hover img {
        transform: scale(1.05);
    }
    .pj-gal-content {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem 1rem 1.1rem;
        text-align: center;
        background: linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.55) 0%,
            rgba(0, 0, 0, 0) 45%,
            rgba(0, 0, 0, 0) 70%,
            rgba(0, 0, 0, 0.45) 100%
        );
    }
    .pj-gal-brand {
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        line-height: 1.35;
        margin: 0 0 1.25rem;
    }
    .pj-gal-title {
        font-size: clamp(20px, 1.6vw, 24px);
        font-weight: 500;
        line-height: 1.1;
        margin: 0;
    }
    .pj-gal-count {
        margin: auto 0 0;
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        opacity: 0.8;
    }

    /* ── Mobile ── */
    @media (max-width: 767px) {
        .pj-page {
            padding: 0 1rem 4rem;
        }
        .pj-grid {
            grid-template-columns: minmax(0, 1fr);
            row-gap: 1.25rem;
        }
        /* Sur mobile, on garde seulement le titre « Projets » */
        .pj-hero-meta {
            display: none;
        }
        /* Cartes plus petites : deux visibles et le début de la suivante */
        .pj-track {
            gap: 0.85rem;
        }
        .pj-card,
        .pj-gal-card {
            flex-basis: 42vw;
        }
        .pj-card-img,
        .pj-gal-card {
            border-radius: 12px;
        }
        .pj-card-img {
            margin-bottom: 0.6rem;
        }
        .pj-card-title {
            font-size: 13px;
        }
        .pj-card-sub {
            font-size: 11px;
        }
        .pj-gal-title {
            font-size: 17px;
        }
        .pj-gal-brand {
            font-size: 7px;
            margin-bottom: 0.75rem;
        }
    }
</style>

<script>
    (function () {
        var reel = document.getElementById("pj-reel");
        var hint = document.getElementById("pj-hint");
        var video = document.getElementById("pj-reel-video") as HTMLVideoElement | null;
        if (!reel || !video) return;
        var r = reel, v = video;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            v.removeAttribute("autoplay");
            v.pause();
        }

        // Fondu du showreel au scroll
        function update() {
            var progress = Math.min(1, window.scrollY / (window.innerHeight * 0.8));
            r.style.opacity = String(1 - progress);
            if (hint) hint.style.opacity = window.scrollY > 40 ? "0" : "1";
            var hidden = progress >= 1;
            r.style.visibility = hidden ? "hidden" : "visible";
            if (hidden && !v.paused) v.pause();
            else if (!hidden && v.paused && v.hasAttribute("autoplay")) v.play().catch(function () {});
        }
        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update);
        window.addEventListener("load", update);
        update();
    })();
</script>
